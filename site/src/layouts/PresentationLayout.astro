    }
    .topbar,
    nav.rail,
    .progress-track,
    .fs-btn {
      display: none !important;
    }
    .stage-layout {
      display: block;
      overflow: visible;
      height: auto;
    }
    #viewport {
      overflow: visible;
      height: auto;
      border: none;
      box-shadow: none;
    }
    .deck-app :global(section.slide) {
      position: static !important;
      display: block !important;
      grid-template-columns: 1fr !important;
      height: auto !important;
      opacity: 1 !important;
      transform: none !important;
      break-after: page;
      page-break-after: always;
      animation: none !important;
      background: white !important;
      color: black !important;
    }
    .deck-app :global(.slide-content),
    .deck-app :global(.slide-figure) {
      display: block !important;
      position: static !important;
      border: none !important;
      box-shadow: none !important;
      overflow: visible !important;
      height: auto !important;
    }
    .deck-app :global(.slide-figure-inner) {
      overflow: visible !important;
      height: auto !important;
    }
    .deck-app :global([class*='-body']) {
      max-height: none !important;
      display: block !important;
      opacity: 1 !important;
    }
    .deck-app :global(.se-panel) {
      display: block !important;
      max-height: none !important;
      opacity: 1 !important;
      margin-bottom: 1rem;
    }
  }
</style>

<script>
  // ===========================================================================
  // DeckController — vanilla progressive-enhancement controller (ADR-TALK-001-B)
  // Reads the static MDX-rendered DOM (section.slide). Builds a hierarchical
  // rail (modules + dots) from data-module, manages activeIndex + isAnimating,
  // applies class-based tones + 28px-fade transition classes. NOT a Preact
  // island — slide content stays static SSG.
  // ===========================================================================
  const deckRoot = document.getElementById('deck-app')
  const viewport = document.getElementById('viewport')
  const rail = document.getElementById('rail')
  const counter = document.getElementById('deck-counter')
  const progress = document.getElementById('progress')
  const track = document.querySelector<HTMLElement>('.progress-track')
  const modeBadge = document.getElementById('mode-badge')
  const prevBtn = document.getElementById('prev') as HTMLButtonElement | null
  const nextBtn = document.getElementById('next') as HTMLButtonElement | null

  // Module titles (EN/ES), keyed by data-module id. Rail titles come from here,
  // NOT from data-title (data-title is retained for a11y aria-label only).
  const MODULES: Record<string, { en: string; es: string }> = {
    '1': { en: 'Problem', es: 'El problema' },
    '2': { en: 'Ground', es: 'Fundamentos' },
    '3': { en: 'The Model', es: 'El modelo' },
    '4': { en: 'How it works', es: 'Cómo funciona' },
    '5': { en: 'Close', es: 'Cierre' },
  }

  if (deckRoot && viewport && rail) {
    const lang = document.documentElement.lang?.startsWith('es') ? 'es' : 'en'
    const slides = Array.from(deckRoot.querySelectorAll<HTMLElement>('section.slide'))
    const n = slides.length
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches

    let activeIndex = 0
    let isAnimating = false

    // Fragment islands (data-fragment-island) expose an imperative API on their
    // DOM node so the DeckController can drive step-reveal via global next/prev.
    function getFragmentIsland(slideEl: HTMLElement | undefined) {
      return slideEl?.querySelector('[data-fragment-island]') as any ?? null
    }

    // ----- Build hierarchical rail: modules + dots from data-module -----
    function buildRail() {
      const order: string[] = []
      const groups: Record<string, number[]> = {}
      slides.forEach((slide, idx) => {
        const mod = slide.dataset.module ?? '1'
        if (!groups[mod]) {
          groups[mod] = []
          order.push(mod)
        }
        groups[mod].push(idx)
      })

      order.forEach((mod) => {
        const indices = groups[mod]
        const moduleEl = document.createElement('div')
        moduleEl.className = 'rail-module'
        moduleEl.dataset.module = mod

        const titleBtn = document.createElement('button')
        titleBtn.type = 'button'
        titleBtn.className = 'rail-title'
        titleBtn.dataset.first = String(indices[0])
        const label = MODULES[mod]?.[lang] ?? `Module ${mod}`
        titleBtn.textContent = label

        const dots = document.createElement('div')
        dots.className = 'rail-dots'
        indices.forEach((slideIdx) => {
          const pip = document.createElement('button')
          pip.type = 'button'
          pip.className = 'rail-pip'
          pip.dataset.index = String(slideIdx)
          pip.setAttribute('aria-label', `Slide ${slideIdx + 1}: ${slides[slideIdx]?.dataset.title ?? ''}`)
          dots.appendChild(pip)
        })

        moduleEl.appendChild(titleBtn)
        moduleEl.appendChild(dots)
        rail!.appendChild(moduleEl)
      })
    }

    buildRail()

    const railModules = Array.from(deckRoot.querySelectorAll<HTMLElement>('.rail-module'))
    const allPips = Array.from(deckRoot.querySelectorAll<HTMLElement>('.rail-pip'))

    function applyChrome(i: number) {
      const tone = slides[i]?.dataset.tone ?? 'blue'
      // tone class on deck-app
      deckRoot!.className = deckRoot!.className.replace(/\btone-\w+/g, '').replace(/\s+/g, ' ').trim()
      deckRoot!.classList.add(`tone-${tone}`)
      // mode badge = tone name
      if (modeBadge) modeBadge.textContent = tone.toUpperCase()
      // counter
      if (counter) counter.textContent = `${String(i + 1).padStart(2, '0')} / ${String(n).padStart(2, '0')}`
      // progress
      const pct = ((i + 1) / n) * 100
      if (progress) progress.style.width = `${pct}%`
      if (track) track.setAttribute('aria-valuenow', String(Math.round(pct)))
      // active module + active pip
      const currentMod = slides[i]?.dataset.module
      railModules.forEach((m) => m.classList.toggle('is-active-module', m.dataset.module === currentMod))
      allPips.forEach((p) => p.classList.toggle('is-active', Number(p.dataset.index) === i))
      // prev/next disabled
      if (prevBtn) prevBtn.disabled = i === 0
      if (nextBtn) nextBtn.disabled = i === n - 1
    }

    function cleanup(slide: HTMLElement) {
      slide.classList.remove('is-entering', 'is-leaving', 'from-next', 'from-prev', 'to-next', 'to-prev')
    }

    function navigateTo(rawIndex: number, direction: 'forward' | 'backward' | 'none') {
      if (isAnimating) return // INTENTIONAL dead-zone guard — do not remove (ADR-TALK-001-B)
      const newIndex = Math.max(0, Math.min(n - 1, rawIndex))
      if (newIndex === activeIndex && direction !== 'none') return

      const outgoing = slides[activeIndex]
      const incoming = slides[newIndex]

      // a11y: mark all non-active hidden, active visible
      slides.forEach((s, j) => s.setAttribute('aria-hidden', j === newIndex ? 'false' : 'true'))

      if (direction === 'none' || prefersReducedMotion || outgoing === incoming) {
        slides.forEach((s) => {
          cleanup(s)
          s.classList.toggle('is-active', s === incoming)
        })
        applyChrome(newIndex)
        activeIndex = newIndex
        if (direction !== 'none') getFragmentIsland(incoming)?.fragmentReset?.()
        try { localStorage.setItem('deck-slide', String(newIndex)) } catch (_) {}
        viewport!.focus()
        return
      }

      isAnimating = true
      cleanup(outgoing)
      cleanup(incoming)

      const enterDir = direction === 'forward' ? 'from-next' : 'from-prev'
      const leaveDir = direction === 'forward' ? 'to-next' : 'to-prev'

      incoming.classList.add('is-active', 'is-entering', enterDir)
      outgoing.classList.remove('is-active')
      outgoing.classList.add('is-leaving', leaveDir)

      applyChrome(newIndex)
      activeIndex = newIndex
      if (direction !== 'none') getFragmentIsland(incoming)?.fragmentReset?.()
      try { localStorage.setItem('deck-slide', String(newIndex)) } catch (_) {}
      viewport!.focus()

      const finish = () => {
        cleanup(outgoing)
        cleanup(incoming)
        isAnimating = false
      }
      incoming.addEventListener('animationend', finish, { once: true })
      // Safety net if animationend never fires.
      window.setTimeout(() => { if (isAnimating) finish() }, 480)
    }

    // Keyboard arbitration — DeckController owns ←→ (always), Space (when focus
    // is NOT inside an island), F (always), plus Home/End/PageUp/PageDown.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'PageDown') {
        const fi = getFragmentIsland(slides[activeIndex])
        if (fi && fi.fragmentAdvance && fi.fragmentAdvance()) {
          e.preventDefault()
        } else {
          navigateTo(activeIndex + 1, 'forward')
          e.preventDefault()
        }
      } else if (e.key === 'ArrowLeft' || e.key === 'PageUp') {
        const fi = getFragmentIsland(slides[activeIndex])
        if (fi && fi.fragmentBack && fi.fragmentBack()) {
          e.preventDefault()
        } else {
          navigateTo(activeIndex - 1, 'backward')
          e.preventDefault()
        }
      } else if (e.key === ' ' || e.key === 'Spacebar') {
        const ae = document.activeElement as HTMLElement | null
        if (!ae?.closest('[data-island]')) {
          const fi = getFragmentIsland(slides[activeIndex])
          if (fi && fi.fragmentAdvance && fi.fragmentAdvance()) {
            e.preventDefault()
          } else {
            navigateTo(activeIndex + 1, 'forward')
            e.preventDefault()
          }
        }
      } else if (e.key === 'Home') {
        navigateTo(0, 'backward')
        e.preventDefault()
      } else if (e.key === 'End') {
        navigateTo(n - 1, 'forward')
        e.preventDefault()
      } else if (e.key === 'f' || e.key === 'F') {
        document.body.classList.toggle('focus-mode')
        e.preventDefault()
      }
    })

    // Rail clicks → module title jumps to first slide; pip jumps to that slide.
    rail.addEventListener('click', (e) => {
      const titleEl = (e.target as HTMLElement).closest<HTMLElement>('.rail-title')
      if (titleEl) {
        const idx = parseInt(titleEl.dataset.first ?? '0', 10)
        const dir = idx > activeIndex ? 'forward' : idx < activeIndex ? 'backward' : 'none'
        navigateTo(idx, dir)
        return
      }
      const pipEl = (e.target as HTMLElement).closest<HTMLElement>('.rail-pip')
      if (pipEl) {
        const idx = parseInt(pipEl.dataset.index ?? '0', 10)
        const dir = idx > activeIndex ? 'forward' : idx < activeIndex ? 'backward' : 'none'
        navigateTo(idx, dir)
      }
    })

    // Prev/Next buttons — delegate to the active slide's fragment island first.
    prevBtn?.addEventListener('click', () => {
      const fi = getFragmentIsland(slides[activeIndex])
      if (fi && fi.fragmentBack && fi.fragmentBack()) return
      navigateTo(activeIndex - 1, 'backward')
    })
    nextBtn?.addEventListener('click', () => {
      const fi = getFragmentIsland(slides[activeIndex])
      if (fi && fi.fragmentAdvance && fi.fragmentAdvance()) return
      navigateTo(activeIndex + 1, 'forward')
    })

    // Touch swipe (40px threshold)
    let touchStartX = 0
    window.addEventListener('touchstart', (e) => {
      touchStartX = e.changedTouches[0].screenX
    }, { passive: true })
    window.addEventListener('touchend', (e) => {
      const delta = e.changedTouches[0].screenX - touchStartX
      if (Math.abs(delta) < 40) return
      if (delta < 0) navigateTo(activeIndex + 1, 'forward')
      else navigateTo(activeIndex - 1, 'backward')
    }, { passive: true })

    // Init: restore saved slide (or 0), no transition.
    const saved = Number(localStorage.getItem('deck-slide')) || 0
    navigateTo(Math.min(Math.max(saved, 0), n - 1), 'none')

    // Print / reduced-motion: reveal all fragments at once (no stepping).
    if (prefersReducedMotion || window.matchMedia('print').matches) {
      slides.forEach((s) => getFragmentIsland(s)?.fragmentShowAll?.())
    }
  }

  // ----- Fullscreen toggle (target #deck-app) -----
  const fsBtn = document.querySelector<HTMLButtonElement>('.fs-btn')

  // Hide site nav/footer while the deck is active; restore on navigation away.
  document.body.setAttribute('data-deck-active', '')
  window.addEventListener('pagehide', () => {
    document.body.removeAttribute('data-deck-active')
  })

  if (deckRoot && fsBtn && deckRoot.requestFullscreen) {
    const enterLabel = fsBtn.dataset.labelEnter ?? 'Enter fullscreen'
    const exitLabel = fsBtn.dataset.labelExit ?? 'Exit fullscreen'
    const syncLabel = () => {
      fsBtn.setAttribute('aria-label', document.fullscreenElement ? exitLabel : enterLabel)
    }
    fsBtn.addEventListener('click', () => {
      if (document.fullscreenElement) document.exitFullscreen()
      else deckRoot.requestFullscreen().catch(() => {})
    })
    document.addEventListener('fullscreenchange', syncLabel)
  } else if (fsBtn) {
    fsBtn.hidden = true // graceful no-op: hide button when API unavailable
  }
</script>
