---
// Inline SVG of the ASDT 7-specialist pipeline for the conference deck (slide 7).
// No props, no JS. All specialist names + keywords are real <text> nodes so they
// are screen-reader- and search-indexable. Node fills use specialist tokens.
const nodes = [
  { name: 'Researcher', token: 'var(--c-res)' },
  { name: 'PM', token: 'var(--c-pm)' },
  { name: 'Architect', token: 'var(--c-arch)' },
  { name: 'Developer', token: 'var(--c-dev)' },
  { name: 'QA', token: 'var(--c-qa)' },
  { name: 'Security', token: 'var(--c-sec)' },
  { name: 'UX/UI', token: 'var(--c-ux)' },
]

interface Props {
  lang?: 'en' | 'es'
}
const { lang = 'en' } = Astro.props

const NODE_W = 124
const NODE_H = 64
const GAP = 16
const X0 = 10
const NODE_Y = 150
const step = NODE_W + GAP
---
<svg
  class="pipeline-diagram"
  viewBox="0 0 980 320"
  role="img"
  aria-labelledby="pipeline-title pipeline-desc"
  xmlns="http://www.w3.org/2000/svg"
>
  <title id="pipeline-title"
    >ASDT pipeline: Researcher to PM to Architect to Developer to QA to Security
    to UX/UI</title
  >
  <desc id="pipeline-desc"
    >Seven specialists in sequence with a human gate between each handoff
    artifact.</desc
  >

  <!-- Orchestrator annotation (top) -->
  <text
    x="490"
    y="44"
    text-anchor="middle"
    fill="var(--dk-muted, #A1AABB)"
    font-family="var(--dk-font-body, serif)"
    font-size="20">Seven specialists — one perspective each</text
  >

  {
    nodes.map((node, i) => {
      const x = X0 + i * step
      const cx = x + NODE_W / 2
      return (
        <>
          {/* handoff connector + gate marker before each node after the first */}
          {i > 0 && (
            <>
              <line
                x1={x - GAP - 1}
                y1={NODE_Y + NODE_H / 2}
                x2={x}
                y2={NODE_Y + NODE_H / 2}
                stroke="var(--dk-divider, #313342)"
                stroke-width="2"
              />
              <rect
                x={x - GAP / 2 - 4}
                y={NODE_Y + NODE_H / 2 - 16}
                width="8"
                height="32"
                rx="2"
                fill="var(--dk-muted, #A1AABB)"
              />
              <text
                x={x - GAP / 2}
                y={NODE_Y - 10}
                text-anchor="middle"
                fill="var(--dk-muted, #A1AABB)"
                font-family="var(--dk-font-mono, monospace)"
                font-size="11">
                gate
              </text>
            </>
          )}
          <rect
            x={x}
            y={NODE_Y}
            width={NODE_W}
            height={NODE_H}
            rx="10"
            fill={node.token}
            stroke="var(--dk-divider, #313342)"
            stroke-width="1"
          />
          <text
            x={cx}
            y={NODE_Y + NODE_H / 2 + 5}
            text-anchor="middle"
            fill="var(--dk-bg, #1c212c)"
            font-family="var(--dk-font-mono, monospace)"
            font-size="16"
            font-weight="600">
            {node.name}
          </text>
        </>
      )
    })
  }

  <!-- handoff / artifact keyword label (lang-aware) -->
  <text
    x="490"
    y="270"
    text-anchor="middle"
    fill="var(--dk-muted, #A1AABB)"
    font-family="var(--dk-font-mono, monospace)"
    font-size="13">{lang === 'es'
      ? 'Cada entrega es un artefacto escrito. Cada gate es del humano.'
      : 'Each handoff is a written artifact. Each gate is human-owned.'}</text
  >

  <!-- anchor phrase / subtitle -->
  <text
    x="490"
    y="300"
    text-anchor="middle"
    font-family="var(--dk-font-display, sans-serif)"
    font-size="22"
    font-weight="600">
    <tspan fill="var(--dk-text, #F3F6F9)">{lang === 'es' ? 'Mismo modelo,' : 'Same model,'}</tspan>
    <tspan fill="var(--dk-muted, #A1AABB)">{lang === 'es' ? ' otra mirada' : ' different lens'}</tspan>
  </text>
</svg>

<style>
  .pipeline-diagram {
    display: block;
    width: 100%;
    height: auto;
    max-width: 980px;
    margin: 0.5rem auto;
  }
</style>
