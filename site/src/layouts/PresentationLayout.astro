---
import BaseLayout from '@layouts/BaseLayout.astro'
import type { Locale } from '@i18n/utils'

interface Props {
  lang: Locale
  title: string
  description: string
  isFallback?: boolean // accepted, NOT rendered (silent fallback)
}

const { lang, title, description } = Astro.props
const isEs = lang === 'es'
const hints = isEs ? '← → · F' : '← → · F'
const eyebrow = isEs ? 'ASDT · presentación' : 'ASDT · presentation'
---
<BaseLayout lang={lang} title={title} description={description}>
  <div class="ambient" aria-hidden="true"></div>
  <div class="deck-app tone-blue" id="deck-app">
    <header class="topbar" role="banner">
      <div class="topbar-left">
        <p class="eyebrow">{eyebrow}</p>
        <h1>{title}</h1>
      </div>
      <div class="status">
        <span class="mode-badge" id="mode-badge">BLUE</span>
        <span id="deck-counter" aria-live="polite" aria-atomic="true">01 / 12</span>
        <span class="hint" aria-hidden="true">{hints}</span>
        <button
          type="button"
          class="fs-btn"
          aria-label={isEs ? 'Entrar en pantalla completa' : 'Enter fullscreen'}
          data-label-enter={isEs ? 'Entrar en pantalla completa' : 'Enter fullscreen'}
          data-label-exit={isEs ? 'Salir de pantalla completa' : 'Exit fullscreen'}
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M8 3H5a2 2 0 0 0-2 2v3" />
            <path d="M21 8V5a2 2 0 0 0-2-2h-3" />
            <path d="M3 16v3a2 2 0 0 0 2 2h3" />
            <path d="M16 21h3a2 2 0 0 0 2-2v-3" />
          </svg>
        </button>
      </div>
    </header>

    <div
      class="progress-track"
      role="progressbar"
      aria-valuemin="0"
      aria-valuemax="100"
      aria-valuenow="8"
      aria-label={isEs ? 'Progreso de slides' : 'Slide progress'}
    >
      <div class="progress-fill" id="progress"></div>
    </div>

    <div class="stage-layout">
      <nav class="rail" id="rail" aria-label={isEs ? 'Navegación de slides' : 'Slide navigation'}></nav>
      <main id="viewport" tabindex="-1" aria-label={isEs ? 'Contenido de la slide' : 'Slide content'}>
        <slot />
      </main>
    </div>

    <footer class="deck-controls">
      <button type="button" class="ghost" id="prev" aria-label={isEs ? 'Anterior' : 'Previous'}>
        {isEs ? '← Anterior' : '← Prev'}
      </button>
      <button type="button" class="solid" id="next" aria-label={isEs ? 'Siguiente' : 'Next'}>
        {isEs ? 'Siguiente →' : 'Next →'}
      </button>
    </footer>
  </div>
</BaseLayout>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,300..900;1,8..60,300..900&display=swap');
</style>

<style>
  .deck-app {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 14px;
    height: 100dvh;
    max-height: 100dvh;
    padding: clamp(16px, 2vw, 24px);

    /* Kanagawa Blur — deck-scoped tokens (additive; no global.css mutation) */
    --dk-bg: #1c212c;
    --dk-bg-alt: #232a36;
    --dk-gray0: #191e28;
    --dk-text: #f3f6f9;
    --dk-muted: #a1aabb;
    --dk-muted-alt: #8394a3;
    --dk-divider: #313342;
    --dk-blue: #7fb4ca;
    --dk-blue-alt: #a3b5d6;
    --dk-green: #b7cc85;
    --dk-yellow: #e0c15a;
    --dk-yellow-alt: #dfbd76;
    --dk-pink: #cb7c94;
    --dk-pink-alt: #ff8dd7;
    --dk-teal: #7aa89f;
    --dk-orange: #deba87;

    /* deck-app shell additions (R3) */
    --dk-selection: #263356;
    --dk-shell-bg: #06080f;
    --dk-radius-pill: 999px;
    --dk-transition-progress: width 320ms ease;

    /* R5 distribution: tone + mode tokens (driven by .deck-app.tone-* class) */
    --tone: var(--dk-blue);
    --tone-glow: rgba(127, 180, 202, 0.24);
    --mode-bg: var(--dk-blue);
    --mode-fg: var(--dk-shell-bg);
    --accent: var(--dk-yellow);

    /* specialist → accent */
    --dk-c-researcher: var(--dk-teal);
    --dk-c-pm: var(--dk-blue);
    --dk-c-architect: var(--dk-orange);
    --dk-c-developer: var(--dk-green);
    --dk-c-qa: var(--dk-yellow);
    --dk-c-security: var(--dk-pink);
    --dk-c-ux: var(--dk-pink-alt);

    /* global token re-wire for deck context */
    --color-bg: var(--dk-bg);
    --color-surface: var(--dk-bg-alt);
    --color-text: var(--dk-text);
    --color-text-muted: var(--dk-muted);
    --color-border: var(--dk-divider);
    --color-accent: var(--dk-blue);

    /* specialist pipeline re-point (PipelineDiagram inherits these) */
    --c-res: var(--dk-teal);
    --c-pm: var(--dk-blue);
    --c-arch: var(--dk-orange);
    --c-dev: var(--dk-green);
    --c-qa: var(--dk-yellow);
    --c-sec: var(--dk-pink);
    --c-ux: var(--dk-pink-alt);

    /* radius */
    --dk-radius-sm: 8px;
    --dk-radius-md: 12px;
    --dk-radius-lg: 16px;

    /* shadows */
    --dk-shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.4), 0 1px 2px rgba(0, 0, 0, 0.3);
    --dk-shadow-md: 0 6px 18px rgba(0, 0, 0, 0.5), 0 2px 8px rgba(0, 0, 0, 0.35);
    --dk-shadow-lg: 0 12px 36px rgba(0, 0, 0, 0.6), 0 5px 16px rgba(0, 0, 0, 0.4);
    --dk-shadow-glow-blue: 0 0 16px rgba(127, 180, 202, 0.2),
      0 0 4px rgba(127, 180, 202, 0.12);
    --dk-shadow-glow-green: 0 0 16px rgba(183, 204, 133, 0.22),
      0 0 4px rgba(183, 204, 133, 0.14);
    --dk-shadow-glow-teal: 0 0 16px rgba(122, 168, 159, 0.2),
      0 0 4px rgba(122, 168, 159, 0.12);

    /* fonts */
    --dk-font-display: 'Space Grotesk Variable', ui-sans-serif, system-ui,
      sans-serif;
    --dk-font-body: 'Source Serif 4', Georgia, 'Times New Roman', serif;
    --dk-font-mono: 'JetBrains Mono Variable', ui-monospace, Menlo, monospace;

    /* accent gradient */
    --dk-accent-gradient: linear-gradient(
      90deg,
      var(--dk-green) 0%,
      var(--dk-yellow) 50%,
      var(--dk-pink) 100%
    );

    /* spacing scale (R2) */
    --dk-space-xs: 0.5rem;
    --dk-space-sm: 0.75rem;
    --dk-space-md: 1.25rem;
    --dk-space-lg: 2rem;
    --dk-space-xl: 3rem;
    --dk-space-2xl: 5rem;

    /* R6 pastel accent tokens */
    --dk-pastel-mint: #c8e6c0;
    --dk-pastel-sky: #bcd8e8;
    --dk-pastel-butter: #ede5b0;
    --dk-pastel-blush: #e8c8d4;
    --dk-pastel-lavender: #cfc8e6;
  }

  /* ----- Ambient backdrop ----- */
  .ambient {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: var(--dk-shell-bg);
  }
  .ambient::before,
  .ambient::after {
    content: '';
    position: absolute;
    border-radius: 999px;
    filter: blur(120px);
    opacity: 0.18;
  }
  .ambient::before {
    width: 42vw;
    height: 42vw;
    left: -8vw;
    top: -6vw;
    background: var(--dk-pink-alt);
  }
  .ambient::after {
    width: 36vw;
    height: 36vw;
    right: -8vw;
    bottom: -6vw;
    background: var(--dk-blue);
  }

  /* ----- Topbar (framed card) ----- */
  .topbar {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 12px;
    padding: 12px 16px;
    border: 1px solid var(--dk-divider);
    border-radius: 14px;
    background: var(--dk-bg);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    box-shadow:
      0 14px 34px rgba(0, 0, 0, 0.42),
      inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }
  .topbar-left {
    min-width: 0;
  }
  .eyebrow {
    margin: 0 0 6px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--dk-muted-alt);
    font-size: 0.7rem;
    font-family: var(--dk-font-display);
  }
  .topbar h1 {
    margin: 0;
    font-family: var(--dk-font-body);
    font-size: clamp(1.4rem, 2.3vw, 2rem);
    color: var(--dk-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .status {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }
  .mode-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 88px;
    padding: 4px 10px;
    border-radius: var(--dk-radius-pill);
    border: 1px solid var(--mode-bg);
    background: var(--mode-bg);
    color: var(--mode-fg);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    margin-bottom: 4px;
    font-family: var(--dk-font-display);
  }
  #deck-counter {
    font-weight: 700;
    font-size: 0.82rem;
    color: var(--accent);
    font-family: var(--dk-font-mono);
  }
  .hint {
    font-size: 0.82rem;
    color: var(--dk-muted-alt);
    font-family: var(--dk-font-mono);
  }
  .fs-btn {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    margin-top: 4px;
    border-radius: var(--dk-radius-sm);
    border: 1px solid var(--color-border);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
  }
  .fs-btn:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  /* ----- Progress bar (pill) ----- */
  .progress-track {
    height: 8px;
    border-radius: var(--dk-radius-pill);
    background: var(--dk-bg-alt);
    border: 1px solid var(--dk-muted-alt);
    overflow: hidden;
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.34);
  }
  .progress-fill {
    height: 100%;
    width: 8.33%;
    background: var(--mode-bg);
    border-radius: inherit;
    transition: var(--dk-transition-progress);
  }

  /* ----- Stage layout ----- */
  .stage-layout {
    min-height: 0;
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 14px;
    overflow: hidden;
  }

  /* ----- Rail (framed card, hierarchical modules) ----- */
  nav.rail {
    border: 1px solid var(--dk-muted-alt);
    border-radius: 18px;
    background: var(--dk-gray0);
    padding: 10px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-height: 0;
    overflow-y: auto;
    overflow-x: hidden;
    box-shadow:
      0 20px 40px rgba(0, 0, 0, 0.42),
      inset 0 1px 0 rgba(255, 255, 255, 0.03);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    scrollbar-width: thin;
  }
  .rail :global(.rail-module) {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .rail :global(.rail-title) {
    border: 1px solid transparent;
    border-radius: 10px;
    background: transparent;
    color: var(--dk-muted-alt);
    text-align: left;
    padding: 7px 9px;
    font-family: var(--dk-font-display);
    font-size: 0.82rem;
    font-weight: 500;
    cursor: pointer;
    transition: 200ms ease;
  }
  .rail :global(.rail-title:hover) {
    color: var(--dk-text);
    border-color: var(--dk-divider);
  }
  .rail :global(.rail-title:focus-visible) {
    outline: 2px solid var(--mode-bg);
    outline-offset: -2px;
  }
  .rail :global(.rail-module.is-active-module > .rail-title) {
    color: var(--dk-text);
    border-color: var(--mode-bg);
    background: var(--dk-selection);
  }
  .rail :global(.rail-dots) {
    display: flex;
    gap: 5px;
    padding: 4px 9px 6px;
    flex-wrap: wrap;
  }
  .rail :global(.rail-pip) {
    width: 7px;
    height: 7px;
    border-radius: var(--dk-radius-pill);
    border: 1px solid var(--dk-muted-alt);
    background: transparent;
    padding: 0;
    cursor: pointer;
    transition: 180ms ease;
  }
  .rail :global(.rail-pip:hover) {
    border-color: var(--dk-muted);
  }
  .rail :global(.rail-pip.is-active) {
    background: var(--mode-bg);
    border-color: var(--mode-bg);
  }

  /* ----- Viewport (framed card + tone glow) ----- */
  #viewport {
    position: relative;
    min-height: 0;
    overflow: hidden;
    border: 1px solid var(--dk-muted-alt);
    border-radius: 18px;
    background: var(--dk-gray0);
    backdrop-filter: blur(9px);
    -webkit-backdrop-filter: blur(9px);
    box-shadow:
      0 26px 56px rgba(0, 0, 0, 0.48),
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      0 0 38px var(--tone-glow);
  }
  #viewport::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    box-shadow: inset 0 0 90px rgba(19, 19, 20, 0.55);
  }
  #viewport:focus {
    outline: none;
  }

  /* ----- Slide model (one-at-a-time, opacity based, 2-col cards) ----- */
  .deck-app :global(section.slide) {
    position: absolute;
    inset: 0;
    min-height: 0;
    padding: clamp(18px, 3vw, 34px);
    display: grid;
    grid-template-columns: minmax(280px, 36%) 1fr;
    gap: clamp(16px, 2vw, 26px);
    align-items: stretch;
    opacity: 0;
    transform: translateX(0);
    pointer-events: none;
    z-index: 1;
    will-change: transform, opacity;
  }
  .deck-app :global(section.slide.slide--wide) {
    grid-template-columns: 1fr;
  }
  .deck-app :global(section.slide.is-active) {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
    z-index: 3;
  }
  .deck-app :global(section.slide.is-entering),
  .deck-app :global(section.slide.is-leaving) {
    pointer-events: none;
  }

  /* Transitions: 28px fade */
  .deck-app :global(section.slide.is-entering.from-next) {
    animation: slide-enter-from-right 420ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }
  .deck-app :global(section.slide.is-entering.from-prev) {
    animation: slide-enter-from-left 420ms cubic-bezier(0.22, 0.61, 0.36, 1) both;
  }
  .deck-app :global(section.slide.is-leaving.to-next) {
    z-index: 2;
    animation: slide-leave-to-left 300ms cubic-bezier(0.4, 0, 0.2, 1) both;
  }
  .deck-app :global(section.slide.is-leaving.to-prev) {
    z-index: 2;
    animation: slide-leave-to-right 300ms cubic-bezier(0.4, 0, 0.2, 1) both;
  }

  @keyframes slide-enter-from-right {
    from { opacity: 0; transform: translateX(28px); }
    to { opacity: 1; transform: translateX(0); }
  }
  @keyframes slide-enter-from-left {
    from { opacity: 0; transform: translateX(-28px); }
    to { opacity: 1; transform: translateX(0); }
  }
  @keyframes slide-leave-to-left {
    from { opacity: 1; transform: translateX(0); }
    to { opacity: 0; transform: translateX(-14px); }
  }
  @keyframes slide-leave-to-right {
    from { opacity: 1; transform: translateX(0); }
    to { opacity: 0; transform: translateX(14px); }
  }

  /* R6 card-settle entrance */
  @keyframes card-settle {
    from { opacity: 0.6; transform: translateY(6px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .deck-app :global(section.slide.is-active .slide-content),
    .deck-app :global(section.slide.is-active .slide-figure) {
      animation: card-settle 280ms ease-out both;
    }
  }

  /* R6 terminal cursor blink */
  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  @media (prefers-reduced-motion: no-preference) {
    .deck-app :global(.install-block)::after {
      content: '▌';
      animation: blink 1s step-start infinite;
      color: var(--dk-green);
      margin-left: 1px;
    }
  }

  /* ----- Slide cards ----- */
  .deck-app :global(.slide-content) {
    border: 1px solid var(--dk-divider);
    border-radius: 16px;
    padding: clamp(16px, 2vw, 24px);
    background: var(--dk-bg);
    min-height: 0;
    overflow-y: auto;
    scrollbar-width: thin;
    box-shadow:
      0 16px 34px rgba(0, 0, 0, 0.36),
      inset 0 1px 0 rgba(255, 255, 255, 0.03);
  }
  .deck-app :global(.slide-kicker) {
    margin: 0 0 10px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--accent);
    font-size: 0.72rem;
    font-family: var(--dk-font-display);
  }
  .deck-app :global(.slide-content h2) {
    margin: 0 0 12px;
    font-family: var(--dk-font-body);
    font-size: clamp(1.3rem, 1.8vw, 1.85rem);
    line-height: 1.2;
    color: var(--dk-text);
  }
  .deck-app :global(.slide-content h3) {
    margin: 0 0 0.4rem;
    font-family: var(--dk-font-display);
    font-size: 1rem;
    color: var(--dk-text);
  }
  .deck-app :global(.slide-content p) {
    margin: 0 0 0.75rem;
    font-family: var(--dk-font-body);
    color: var(--dk-muted);
    line-height: 1.6;
  }
  .deck-app :global(.slide-content p:last-child) {
    margin-bottom: 0;
  }
  .deck-app :global(.slide-content strong) {
    color: var(--dk-text);
  }
  .deck-app :global(.slide-content a) {
    color: var(--color-accent);
  }

  .deck-app :global(.slide-figure) {
    margin: 0;
    border: 1px solid var(--dk-divider);
    border-radius: 16px;
    padding: 10px;
    background: var(--dk-gray0);
    min-height: 0;
    min-width: 0;
    overflow: hidden;
    box-shadow:
      0 22px 42px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.03);
  }
  .deck-app :global(.slide-figure-inner) {
    height: 100%;
    min-height: 0;
    overflow-y: auto;
    scrollbar-width: thin;
  }
  .deck-app :global(.slide-figure svg),
  .deck-app :global(.slide-figure .layer-diagram) {
    width: 100%;
    height: 100%;
    max-height: 100%;
    object-fit: contain;
    display: block;
  }

  /* ----- Deck controls (footer row) ----- */
  .deck-controls {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
  }
  .deck-controls button {
    border-radius: 12px;
    border: 1px solid var(--dk-muted-alt);
    padding: 10px 16px;
    font-family: var(--dk-font-display);
    font-size: 0.88rem;
    font-weight: 500;
    cursor: pointer;
    transition: transform 150ms ease;
  }
  .deck-controls button:hover:not(:disabled) {
    transform: translateY(-1px);
  }
  .deck-controls button:disabled {
    opacity: 0.42;
    cursor: not-allowed;
    transform: none;
  }
  .deck-controls .ghost {
    background: var(--dk-bg);
    color: var(--dk-text);
  }
  .deck-controls .solid {
    background: var(--mode-bg);
    color: var(--mode-fg);
  }

  /* ----- Tone classes (8 tones; drive --tone/--tone-glow/--mode-bg/--mode-fg) ----- */
  .deck-app.tone-blue    { --tone: var(--dk-blue);      --tone-glow: rgba(127, 180, 202, 0.24); --mode-bg: var(--dk-blue);      --mode-fg: var(--dk-shell-bg); }
  .deck-app.tone-yellow  { --tone: var(--dk-yellow-alt); --tone-glow: rgba(223, 189, 118, 0.22); --mode-bg: var(--dk-yellow-alt); --mode-fg: var(--dk-shell-bg); }
  .deck-app.tone-green   { --tone: var(--dk-green);     --tone-glow: rgba(183, 204, 133, 0.22); --mode-bg: var(--dk-green);     --mode-fg: var(--dk-shell-bg); }
  .deck-app.tone-purple  { --tone: var(--dk-blue-alt);  --tone-glow: rgba(163, 181, 214, 0.24); --mode-bg: var(--dk-blue-alt);  --mode-fg: var(--dk-shell-bg); }
  .deck-app.tone-cyan    { --tone: var(--dk-teal);      --tone-glow: rgba(122, 168, 159, 0.24); --mode-bg: var(--dk-teal);      --mode-fg: var(--dk-shell-bg); }
  .deck-app.tone-magenta { --tone: var(--dk-pink-alt);  --tone-glow: rgba(255, 141, 215, 0.24); --mode-bg: var(--dk-pink-alt);  --mode-fg: var(--dk-shell-bg); }
  .deck-app.tone-orange  { --tone: var(--dk-orange);    --tone-glow: rgba(222, 186, 135, 0.22); --mode-bg: var(--dk-orange);    --mode-fg: var(--dk-shell-bg); }
  .deck-app.tone-red     { --tone: var(--dk-pink);      --tone-glow: rgba(203, 124, 148, 0.24); --mode-bg: var(--dk-pink);      --mode-fg: var(--dk-shell-bg); }

  /* ----- Focus mode (F toggles body class) ----- */
  :global(body.focus-mode) .stage-layout {
    grid-template-columns: 1fr;
  }
  :global(body.focus-mode) nav.rail {
    display: none;
  }

  /* ----- Reused inner content helpers (kept; used inside cards) ----- */
  .deck-app :global(.dk-glass) {
