---
import { specialistComparison } from '@data/specialist-comparison'
import type { SpecialistComparisonRow } from '@data/specialist-comparison'
import { SPECIALIST_COLOR, SPECIALIST_LABEL } from '@data/artifact-graph'
import type { SpecialistId } from '@data/artifact-graph'
import { useTranslations } from '@i18n/utils'
import type { Locale } from '@i18n/utils'

interface Props {
  lang: Locale
  rows?: SpecialistComparisonRow[]
}

const { lang, rows = specialistComparison } = Astro.props
const t = useTranslations(lang)
const isEs = lang === 'es'

// Reuses SpecialistCard.astro's icon vocabulary verbatim for the 6 shared ids;
// researcher (not covered there) gets an added search-glyph icon.
const iconPaths: Record<SpecialistId, string> = {
  pm: 'M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01',
  architect: 'M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z',
  developer: 'M16 18 22 12 16 6M8 6 2 12 8 18',
  qa: 'M9 12l2 2 4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0z',
  security: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
  'ux-ui': 'M2 13.5V19a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-5.5M22 10.5 12 5 2 10.5M12 5v14',
  researcher: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM21 21l-4.35-4.35',
}

const labelInvoke = isEs ? 'Invocar cuando…' : 'Invoke when…'
const labelProduces = t.docs.produces
const labelDoNotUse = isEs ? 'No usar cuando…' : 'Do NOT use when…'
const labelExample = isEs ? 'Comando de ejemplo' : 'Example command'

function commandLiteral(exampleCommand: string): string {
  return exampleCommand.split(' ')[0]
}
---

<div class="cmp-accordion">
  {rows.map((row) => {
    const colorVar = SPECIALIST_COLOR[row.specialistId]
    const name = SPECIALIST_LABEL[row.specialistId]
    const iconPath = iconPaths[row.specialistId]
    return (
      <details class="cmp-row" style={`--sc: var(${colorVar});`}>
        <summary class="cmp-summary">
          <span class="cmp-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d={iconPath} />
            </svg>
          </span>
          <span class="cmp-name">{name}</span>
          <code class="cmp-cmd">{commandLiteral(row.exampleCommand)}</code>
          <span class="cmp-teaser">{isEs ? row.teaserEs : row.teaserEn}</span>
          <svg class="cmp-chevron" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </summary>
        <div class="cmp-body">
          <dl class="cmp-fields">
            <dt>{labelInvoke}</dt>
            <dd>{isEs ? row.invokeWhenEs : row.invokeWhenEn}</dd>
            <dt>{labelProduces}</dt>
            <dd>{isEs ? row.producesEs : row.producesEn}</dd>
            <dt>{labelDoNotUse}</dt>
            <dd>{isEs ? row.doNotUseWhenEs : row.doNotUseWhenEn}</dd>
            <dt>{labelExample}</dt>
            <dd>
              <pre class="cmp-pre"><code>{row.exampleCommand}</code></pre>
            </dd>
          </dl>
        </div>
      </details>
    )
  })}
</div>

<style>
.cmp-accordion {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin: 24px 0;
}

.cmp-row {
  border: 1px solid var(--border-soft);
  border-radius: 12px;
  background: var(--surface-2);
  overflow: hidden;
}

.cmp-row[open] {
  background: oklch(from var(--sc) l c h / 0.06);
  border-color: oklch(from var(--sc) l c h / 0.30);
}

.cmp-summary {
  list-style: none;
  cursor: pointer;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12px;
  min-height: 44px;
  padding: 14px 18px;
}

.cmp-summary::-webkit-details-marker {
  display: none;
}

.cmp-summary::marker {
  content: '';
}

.cmp-summary:hover {
  background: oklch(from var(--sc) l c h / 0.04);
}

.cmp-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32px;
  height: 32px;
  border-radius: 9px;
  color: var(--sc);
  background: oklch(from var(--sc) l c h / 0.12);
  border: 1px solid oklch(from var(--sc) l c h / 0.30);
}

.cmp-name {
  flex-shrink: 0;
  font-weight: 600;
  font-size: 15.5px;
  color: var(--sc);
}

.cmp-cmd {
  flex-shrink: 0;
  font-family: var(--font-mono);
  font-size: 11.5px;
  color: var(--sc);
  border: 1px solid oklch(from var(--sc) l c h / 0.35);
  background: oklch(from var(--sc) l c h / 0.08);
  border-radius: 999px;
  padding: 2px 10px;
  white-space: nowrap;
}

.cmp-teaser {
  flex: 1 1 220px;
  min-width: 0;
  font-size: 14px;
  color: var(--color-text-muted);
  line-height: 1.5;
}

.cmp-chevron {
  flex-shrink: 0;
  margin-left: auto;
  color: var(--faint);
}

@media (prefers-reduced-motion: no-preference) {
  .cmp-chevron {
    transition: transform 0.2s ease;
  }
}

.cmp-row[open] .cmp-chevron {
  transform: rotate(180deg);
}

.cmp-body {
  padding: 4px 18px 20px 64px;
}

.cmp-fields {
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.cmp-fields dt {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--faint);
  margin-top: 14px;
}

.cmp-fields dt:first-child {
  margin-top: 0;
}

.cmp-fields dd {
  margin: 4px 0 0;
  font-size: 14.5px;
  color: oklch(0.86 0.008 285);
  line-height: 1.6;
}

.cmp-pre {
  margin: 0;
  border: 1px solid var(--color-border);
  border-radius: 10px;
  background: var(--bg-deep);
  padding: 12px 14px;
  overflow-x: auto;
}

.cmp-pre code {
  font-family: var(--font-mono);
  font-size: 13px;
  line-height: 1.7;
  color: inherit;
  white-space: pre;
  background: none;
  border: none;
  padding: 0;
}

@media (max-width: 640px) {
  .cmp-summary {
    padding: 12px 14px;
  }
  .cmp-teaser {
    flex-basis: 100%;
    order: 5;
  }
  .cmp-body {
    padding: 4px 14px 18px 14px;
  }
}

html[data-theme='light'] .cmp-fields dd {
  color: var(--color-text);
}
</style>
