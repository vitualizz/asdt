{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Edit(**/.claude/settings.json)",
      "Edit(**/.claude/**)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/secrets/**)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/.zshrc)",
      "Edit(**/.bashrc)",
      "Edit(**/.bash_profile)",
      "Edit(**/.profile)",
      "Edit(**/.envrc)",
      "Edit(**/.npmrc)",
      "Edit(**/.gitconfig)",
      "Edit(**/.mcp.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(cat **/.env*)",
      "Bash(printenv*)",
      "Bash(base64 **/.env*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)"
    ]
  },
  "skipDangerousModePermissionPrompt": true
}
