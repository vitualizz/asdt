<section data-label="Seven specialists" data-speaker-notes="One feature, seven specialists. Each a fresh, bounded lens. It's not an assembly line: the order flexes and they all depend on each other. Each one produces a concrete document." style="color:#dfe4ec;font-family:'Instrument Sans',system-ui,sans-serif;box-sizing:border-box;padding:74px 96px;display:flex;flex-direction:column;justify-content:center;position:relative;overflow:hidden;background-color:#0b0c11;background-image:radial-gradient(1100px 640px at 88% -14%,oklch(72% .15 300/.16),transparent 66%),radial-gradient(820px 560px at 0% 112%,oklch(66% .13 300/.10),transparent 70%),radial-gradient(rgba(255,255,255,.05) 1px,transparent 1px);background-size:auto,auto,34px 34px;">
  <div style="position:absolute;top:50px;right:64px;display:flex;align-items:center;gap:12px;font-family:'JetBrains Mono',monospace;font-size:18px;letter-spacing:.06em;color:#828b99;font-weight:700;"><span style="display:flex;gap:3px;"><span style="width:6px;height:15px;border-radius:2px;background:oklch(76% .145 75)"></span><span style="width:6px;height:15px;border-radius:2px;background:oklch(74% .145 300)"></span><span style="width:6px;height:15px;border-radius:2px;background:oklch(74% .145 245)"></span><span style="width:6px;height:15px;border-radius:2px;background:oklch(76% .145 155)"></span><span style="width:6px;height:15px;border-radius:2px;background:oklch(72% .145 25)"></span><span style="width:6px;height:15px;border-radius:2px;background:oklch(75% .145 340)"></span></span>ASDT</div>
  <div class="au" style="margin-bottom:26px;">
