---
import { TerminologyExplorer } from './TerminologyExplorer'
import type { Locale } from '@i18n/utils'

interface Props {
  lang: Locale
}
const { lang } = Astro.props
const isEs = lang === 'es'

const terms = [
  {
    icon: '▣',
    name: isEs ? 'Artefacto' : 'Artifact',
    def: isEs
      ? 'Un resultado escrito que un step deja atrás — lo que sobrevive a un reset de contexto.'
      : 'A written output a step leaves behind — the thing that survives a context reset.',
    ex: isEs
      ? 'El ADR del Architect es un artefacto — existe después de que la conversación termina.'
      : 'The Architect’s ADR is an artifact — it exists after the conversation ends.',
  },
  {
    icon: '✦',
    name: 'Brief',
    def: isEs
      ? 'Un documento corto y estructurado que se pasa de un step al siguiente.'
      : 'A short, structured document handed from one step to the next.',
    ex: isEs
      ? 'El PM escribe un brief; el Architect lo lee para arrancar.'
      : 'The PM writes a brief; the Architect reads it to start.',
  },
  {
    icon: '→',
    name: 'Step',
    def: isEs
      ? 'Una unidad de trabajo: lee un artefacto, produce un artefacto.'
      : 'One unit of work: reads one artifact, produces one artifact.',
    ex: isEs
      ? '«feature-brief» es un step dentro del especialista de UX/UI.'
      : '“feature-brief” is a step inside the UX/UI specialist.',
  },
  {
    icon: '◎',
    name: isEs ? 'Especialista' : 'Specialist',
    def: isEs
      ? 'Un rol, una mirada — Researcher, Architect, Developer y más.'
      : 'One role, one lens — Researcher, Architect, Developer, and more.',
    ex: isEs
      ? 'Siete especialistas = siete formas distintas de mirar la misma funcionalidad.'
      : 'Seven specialists = seven different ways of looking at the same feature.',
  },
  {
    icon: '⟳',
    name: isEs ? 'Orquestador' : 'Orchestrator',
    def: isEs
      ? 'Corre los steps de un especialista en orden. Coordina, nunca programa directamente.'
      : 'Runs a specialist’s steps in order. Coordinates, never codes directly.',
    ex: isEs
      ? 'El orquestador de UX corre: feature-brief → IA → flujos → componentes → handoff.'
      : 'The UX orchestrator runs: feature-brief → IA → flows → components → handoff.',
  },
  {
    icon: '⌥',
    name: 'Router',
    def: isEs
      ? 'Lee tu pedido y recomienda qué especialista encaja.'
      : 'Reads your request and recommends which specialist fits.',
    ex: isEs
      ? '/asdt agregar login → Router: «esto suena a Architect + Developer».'
      : '/asdt add login → Router: “this sounds like Architect + Developer.”',
  },
  {
    icon: '⊘',
    name: 'Gate',
    def: isEs
      ? 'Una pausa para que un humano revise y apruebe antes de continuar.'
      : 'A pause for a human to review and approve before work continues.',
    ex: isEs
      ? 'El PM le pasa el trabajo al Architect. Tú abres el gate — no la IA.'
      : 'PM hands off to Architect. You open the gate — not the AI.',
  },
]
---

<div class="teb-wrap">
  <TerminologyExplorer client:visible lang={lang} />

  <noscript>
    <ul class="teb-ns" aria-label={isEs ? 'Conceptos clave de ASDT' : 'ASDT Terminology'}>
      {
        terms.map((t) => (
          <li>
            <span class="teb-ns-icon" aria-hidden="true">{t.icon}</span>
            <strong>{t.name}</strong> — {t.def} <em>{t.ex}</em>
          </li>
        ))
      }
    </ul>
  </noscript>
</div>

<style>
  .teb-wrap {
    height: 100%;
    min-height: 0;
  }

  .teb-wrap :global(.te) {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: var(--dk-space-sm, 0.75rem);
  }

  .teb-wrap :global(.te-card) {
    border: 1px solid var(--dk-divider);
    border-radius: var(--dk-radius-md, 12px);
    background: var(--dk-bg-alt);
    padding: var(--dk-space-sm, 0.75rem) var(--dk-space-md, 1.25rem);
    transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }

  .teb-wrap :global(.te-card-trigger) {
    display: block;
    width: 100%;
    border: none;
    background: none;
    padding: 0;
    margin: 0;
    text-align: left;
    cursor: pointer;
    font: inherit;
    color: inherit;
  }

  .teb-wrap :global(.te-card:hover) {
    border-color: color-mix(in srgb, var(--card-accent) 60%, transparent);
    transform: translateY(-1px);
  }

  .teb-wrap :global(.te-card--open) {
    border-color: var(--card-accent);
    box-shadow: 0 0 12px color-mix(in srgb, var(--card-accent) 20%, transparent);
    grid-column: 1 / -1;
  }

  .teb-wrap :global(.te-card-trigger:focus-visible) {
    outline: 2px solid var(--card-accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  .teb-wrap :global(.te-card-head) {
    display: flex;
    align-items: center;
    gap: var(--dk-space-xs, 0.5rem);
  }

  .teb-wrap :global(.te-icon) {
    font-size: 1.4rem;
    line-height: 1;
    color: var(--card-accent);
  }

  .teb-wrap :global(.te-term) {
    font-family: var(--dk-font-display);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--dk-text);
    flex: 1;
  }

  .teb-wrap :global(.te-chevron) {
    font-family: var(--dk-font-mono);
    color: var(--dk-muted);
    font-size: 1rem;
  }

  .teb-wrap :global(.te-card-body) {
    max-height: 0;
    overflow: hidden;
    transition: max-height 200ms ease, opacity 150ms ease;
    opacity: 0;
  }

  .teb-wrap :global(.te-card-body:not([aria-hidden='true'])) {
    max-height: 400px;
    opacity: 1;
  }

  .teb-wrap :global(.te-divider) {
    height: 1px;
    background: color-mix(in srgb, var(--card-accent) 40%, transparent);
    margin: var(--dk-space-sm, 0.75rem) 0;
  }

  .teb-wrap :global(.te-def) {
    font-family: var(--dk-font-body);
    font-size: 0.9rem;
    color: var(--dk-text);
    margin: 0 0 var(--dk-space-sm, 0.75rem);
    line-height: 1.5;
  }

  .teb-wrap :global(.te-example) {
    font-family: var(--dk-font-body);
    font-style: italic;
    font-size: 0.85rem;
    color: var(--dk-muted);
    margin: 0;
    padding: 0.5rem 0.75rem;
    border-left: 2px solid var(--card-accent);
    background: color-mix(in srgb, var(--card-accent) 6%, transparent);
    border-radius: 0 4px 4px 0;
    line-height: 1.5;
  }

  .teb-wrap :global(.te-def-label) {
    font-family: var(--dk-font-mono);
    text-transform: uppercase;
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    color: var(--dk-muted);
    margin-right: 0.35rem;
  }

  .teb-ns {
    list-style: none;
    padding: 0;
    margin: var(--dk-space-md, 1.25rem) 0;
    color: var(--dk-text);
  }
  .teb-ns li {
    margin: 0 0 0.6rem;
    font-family: var(--dk-font-body);
    font-size: 0.9rem;
    color: var(--dk-muted);
  }
  .teb-ns li strong {
    color: var(--dk-text);
  }
  .teb-ns-icon {
    margin-right: 0.35rem;
  }

  @media print {
    .teb-wrap :global(.te-card-body) {
      max-height: none !important;
      overflow: visible !important;
      display: block !important;
    }
    .teb-ns {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .teb-wrap :global(.te-card-body) {
      transition: none !important;
    }
    .teb-wrap :global(.te-card) {
      transition: none !important;
    }
  }
</style>
