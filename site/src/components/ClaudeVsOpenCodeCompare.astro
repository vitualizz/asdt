---
import type { Locale } from '@i18n/utils'

interface CompareRow {
  labelEn: string
  labelEs: string
  claudeEn: string
  claudeEs: string
  openCodeEn: string
  openCodeEs: string
}

interface Props {
  lang: Locale
}

const { lang } = Astro.props

// Source: "Claude Code vs OpenCode" table in src/content/docs/{en,es}/ai-assistants.md
const rows: CompareRow[] = [
  {
    labelEn: 'Skills directory',
    labelEs: 'Directorio de skills',
    claudeEn: '`~/.claude/skills`',
    claudeEs: '`~/.claude/skills`',
    openCodeEn: '`~/.config/opencode/skills` (respects `XDG_CONFIG_HOME`)',
    openCodeEs: '`~/.config/opencode/skills` (respeta `XDG_CONFIG_HOME`)',
  },
  {
    labelEn: 'Executor agents',
    labelEs: 'Agentes ejecutores',
    claudeEn:
      '`~/.claude/agents/asdt-analyst.md` + `asdt-builder.md`, rendered with an explicit `tools:` allowlist',
    claudeEs:
      '`~/.claude/agents/asdt-analyst.md` + `asdt-builder.md`, generados con una lista explícita de herramientas (`tools:`)',
    openCodeEn:
      '`~/.config/opencode/agents/asdt-analyst.md` + `asdt-builder.md`, rendered as `mode: subagent` with a structural `permission:` block',
    openCodeEs:
      '`~/.config/opencode/agents/asdt-analyst.md` + `asdt-builder.md`, generados como `mode: subagent` con un bloque estructural `permission:`',
  },
  {
    labelEn: 'Agent config',
    labelEs: 'Configuración del agente',
    claudeEn:
      'Injected as a tagged block into `~/.claude/CLAUDE.md` (wrapped in `<!-- asdt:agent-config -->` markers so it updates in place and removes cleanly)',
    claudeEs:
      'Inyectada como un bloque etiquetado dentro de `~/.claude/CLAUDE.md` (envuelto en marcadores `<!-- asdt:agent-config -->` para que se actualice en el mismo lugar y se elimine limpiamente)',
    openCodeEn:
      "Written as `~/.config/opencode/AGENTS.md`, OpenCode's native global agent config",
    openCodeEs:
      'Escrita como `~/.config/opencode/AGENTS.md`, la configuración global nativa de agentes de OpenCode',
  },
  {
    labelEn: 'Command wrappers',
    labelEs: 'Envoltorios de comandos',
    claudeEn: 'None — Claude Code invokes the specialist skills directly',
    claudeEs: 'Ninguno — Claude Code invoca las skills de especialistas directamente',
    openCodeEn:
      'Generated per specialist under `~/.config/opencode/commands/<specialist>.md` — thin wrappers that load and activate the matching skill',
    openCodeEs:
      'Generados por especialista en `~/.config/opencode/commands/<especialista>.md` — envoltorios ligeros que cargan y activan la skill correspondiente',
  },
  {
    labelEn: 'Permission overlay',
    labelEs: 'Capa de permisos',
    claudeEn:
      'Optional structural merge into `~/.claude/settings.json` (bypass mode behind a self-protecting deny-net)',
    claudeEs:
      'Opcional: fusión estructural en `~/.claude/settings.json` (modo bypass detrás de una red de denegación que se autoprotege)',
    openCodeEn:
      'Not applicable — per-agent permissions are declared inline in each agent definition instead',
    openCodeEs:
      'No aplica — los permisos por agente se declaran de forma inline en cada definición de agente',
  },
  {
    labelEn: 'Install manifest',
    labelEs: 'Manifiesto de instalación',
    claudeEn: '`.install-meta.json` alongside the skills',
    claudeEs: '`.install-meta.json` junto a las skills',
    openCodeEn: '`.install-meta.json` alongside the skills',
    openCodeEs: '`.install-meta.json` junto a las skills',
  },
]

const captionEn =
  'Where each installed piece lands and what shape it takes, Claude Code compared with OpenCode.'
const captionEs =
  'Dónde aterriza cada pieza instalada y qué forma toma, comparando Claude Code con OpenCode.'

const aspectHeadEn = 'Concern'
const aspectHeadEs = 'Aspecto'

const caption = lang === 'es' ? captionEs : captionEn
const aspectHead = lang === 'es' ? aspectHeadEs : aspectHeadEn

// Renders a limited set of inline `code` spans from plain text without a full markdown parser.
function renderInline(text: string): string {
  const escaped = text
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
  return escaped.replace(/`([^`]+)`/g, '<code>$1</code>')
}
---

<div class="cvo-wrap">
  <table class="cvo-table">
    <caption>{caption}</caption>
    <thead>
      <tr>
        <th scope="col">{aspectHead}</th>
        <th scope="col">Claude Code</th>
        <th scope="col">OpenCode</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr>
          <th scope="row">{lang === 'es' ? row.labelEs : row.labelEn}</th>
          <td
            data-label="Claude Code"
            set:html={renderInline(lang === 'es' ? row.claudeEs : row.claudeEn)}
          />
          <td
            data-label="OpenCode"
            set:html={renderInline(lang === 'es' ? row.openCodeEs : row.openCodeEn)}
          />
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
.cvo-wrap {
  max-width: 920px;
  margin: 32px auto;
  border: 1px solid var(--border-soft);
  border-radius: 18px;
  background: oklch(0.165 0.014 285 / 0.75);
  overflow: hidden;
}

.cvo-table {
  width: 100%;
  border-collapse: collapse;
}

.cvo-table caption {
  text-align: left;
  padding: 20px 24px 14px;
  font-size: 14px;
  line-height: 1.6;
  color: var(--color-text-muted);
  caption-side: top;
}

.cvo-table thead th {
  font-family: var(--font-mono);
  font-size: 12px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--faint);
  text-align: left;
  padding: 12px 20px;
  border-top: 1px solid var(--border-soft);
  border-bottom: 1px solid var(--border-soft);
}

.cvo-table thead th:nth-child(2),
.cvo-table thead th:nth-child(3) {
  color: var(--color-accent);
}

.cvo-table tbody th[scope='row'] {
  text-align: left;
  vertical-align: top;
  font-weight: 600;
  font-size: 14.5px;
  color: var(--color-text);
  padding: 16px 20px;
  width: 22%;
  border-top: 1px solid var(--border-soft);
}

.cvo-table tbody td {
  text-align: left;
  vertical-align: top;
  font-size: 14px;
  line-height: 1.6;
  color: var(--color-text-muted);
  padding: 16px 20px;
  border-top: 1px solid var(--border-soft);
}

.cvo-table tbody tr:first-child th,
.cvo-table tbody tr:first-child td {
  border-top: none;
}

.cvo-table tbody td :global(code),
.cvo-table tbody th :global(code) {
  font-family: var(--font-mono);
  font-size: 0.92em;
  background: oklch(from var(--color-accent) l c h / 0.1);
  color: var(--color-accent);
  padding: 1px 5px;
  border-radius: 5px;
  white-space: normal;
  overflow-wrap: break-word;
  word-break: break-word;
}

/* Mobile: collapse the table into stacked cards. Each value repeats its
   column label inline via data-label so context is never lost when the
   visual grid disappears. */
@media (max-width: 760px) {
  .cvo-table thead {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .cvo-table,
  .cvo-table tbody,
  .cvo-table tbody tr,
  .cvo-table tbody th,
  .cvo-table tbody td {
    display: block;
    width: auto;
  }

  .cvo-table tbody tr {
    padding: 18px 20px 14px;
    border-top: 1px solid var(--border-soft);
  }

  .cvo-table tbody tr:first-child {
    border-top: none;
  }

  .cvo-table tbody th[scope='row'] {
    padding: 0 0 10px;
    border-top: none;
    font-size: 15px;
  }

  .cvo-table tbody td {
    padding: 8px 0 0;
    border-top: none;
  }

  .cvo-table tbody td::before {
    content: attr(data-label) ': ';
    display: inline;
    font-family: var(--font-mono);
    font-size: 11.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-right: 2px;
  }
}
</style>
