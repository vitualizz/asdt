---
import { SpecialistExplorer } from './SpecialistExplorer'
import { specialistSteps } from '@data/specialist-steps'
import type { Locale } from '@i18n/utils'

interface Props {
  lang: Locale
}
const { lang } = Astro.props
const isEs = lang === 'es'

// Build-time derivation of richer noscript data from the canonical step source.
// EN purposes only in noscript (informational fallback, not full feature parity).
// The slug list per specialist mirrors SpecialistExplorer.tsx PIPELINE_SPECIALISTS.
const noscriptSpecialists: {
  name: string
  role: string
  artifact: string
  steps: { slug: string; purpose: string; produces: string }[]
}[] = [
  {
    id: 'researcher',
    name: isEs ? 'Investigador' : 'Researcher',
    role: isEs ? 'Descubrimiento — diverge antes de que PM converja' : 'Discovery — diverges before PM converges',
    artifact: isEs ? 'Brief de descubrimiento' : 'Discovery brief',
    slugs: ['context-recall', 'divergent-ideation', 'feasibility-scan', 'discovery-brief', 'decision-preservation'],
  },
  {
    id: 'pm',
    name: 'PM',
    role: isEs ? 'Formaliza los requisitos' : 'Formalizes requirements',
    artifact: isEs ? 'Entrada de backlog' : 'Backlog entry',
    slugs: ['feature-intake', 'user-stories', 'scope-analysis', 'backlog-entry'],
  },
  {
    id: 'architect',
    name: isEs ? 'Arquitecto' : 'Architect',
    role: isEs ? 'Decisiones técnicas' : 'Technical decisions',
    artifact: isEs ? 'ADR + diseño del sistema' : 'ADR + system design',
    slugs: ['load-constraints', 'evaluate-approaches', 'decision-record', 'system-design', 'risk-analysis', 'technical-handoff'],
  },
  {
    id: 'developer',
    name: isEs ? 'Desarrollador' : 'Developer',
    role: isEs ? 'Construye el código' : 'Builds the code',
    artifact: isEs ? 'Implementación' : 'Implementation',
    slugs: ['explore', 'spec', 'design', 'implement'],
  },
  {
    id: 'qa',
    name: 'QA',
    role: isEs ? 'Control de calidad' : 'Quality gate',
    artifact: isEs ? 'Plan de pruebas + reporte de calidad' : 'Test plan + quality report',
    slugs: ['load-requirements', 'ac-validation', 'edge-case-analysis', 'test-strategy', 'test-case-generation', 'quality-report', 'review'],
  },
  {
    id: 'security',
    name: isEs ? 'Seguridad' : 'Security',
    role: isEs ? 'Amenazas — puede correr en cualquier momento' : 'Threats — runs at any point',
    artifact: isEs ? 'Modelo de amenazas + checklist de endurecimiento' : 'Threat model + hardening checklist',
    slugs: ['threat-modeling', 'attack-surface', 'owasp-analysis', 'hardening-checklist'],
  },
  {
    id: 'ux-ui',
    name: 'UX/UI',
    role: isEs ? 'La experiencia' : 'The experience',
    artifact: isEs ? 'Brief de UX + spec de componentes' : 'UX brief + component spec',
    slugs: ['feature-brief', 'information-architecture', 'user-flows', 'component-mapping', 'ux-handoff'],
  },
].map(({ id, name, role, artifact, slugs }) => ({
  name,
  role,
  artifact,
  steps: slugs.map((slug) => {
    const step = specialistSteps[id]?.steps[slug]
    return { slug, purpose: step?.purpose ?? '', produces: step?.produces ?? '' }
  }),
}))

const producesLabel = isEs ? 'Produce:' : 'Produces:'
---

<div class="seb-wrap">
  <SpecialistExplorer client:visible lang={lang} />

  <noscript>
    <dl class="seb-ns">
      {
        noscriptSpecialists.map((s) => (
          <>
            <dt>
              {s.name} — {s.role}
            </dt>
            <dd>
              <ul class="seb-ns-steps">
                {s.steps.map((step) => (
                  <li>
                    <code>{step.slug}</code>: {step.purpose} → {step.produces}
                  </li>
                ))}
              </ul>
              <span class="seb-ns-artifact">
                {producesLabel} {s.artifact}
              </span>
            </dd>
          </>
        ))
      }
    </dl>
  </noscript>
</div>

<style>
  .seb-wrap {
    height: 100%;
    min-height: 0;
    display: flex;
    flex-direction: column;
  }

  .seb-wrap :global(.se-nodes) {
    display: flex;
    align-items: center;
    gap: 0;
    width: 100%;
    flex-wrap: nowrap;
  }

  .seb-wrap :global(.se-node) {
    flex: 1 1 0;
    min-width: 80px;
    padding: 0.55rem 0.4rem;
    border-radius: var(--dk-radius-sm, 8px);
    border: 1.5px solid color-mix(in srgb, var(--sc) 50%, transparent);
    background: color-mix(in srgb, var(--sc) 15%, var(--dk-bg-alt));
    color: var(--dk-text);
    font-family: var(--dk-font-display);
    font-size: clamp(0.65rem, 1.2vw, 0.82rem);
    font-weight: 600;
    cursor: pointer;
    text-align: center;
    transition: background 0.15s, border-color 0.15s, box-shadow 0.15s, transform 0.15s;
  }

  .seb-wrap :global(.se-node:hover) {
    background: color-mix(in srgb, var(--sc) 22%, var(--dk-bg-alt));
    border-color: color-mix(in srgb, var(--sc) 80%, transparent);
    transform: translateY(-1px);
  }

  .seb-wrap :global(.se-node--active) {
    background: color-mix(in srgb, var(--sc) 25%, var(--dk-bg-alt));
    border-color: var(--sc);
    box-shadow: 0 0 12px color-mix(in srgb, var(--sc) 25%, transparent);
  }

  .seb-wrap :global(.se-node:focus-visible) {
    outline: 2px solid var(--sc);
    outline-offset: 2px;
  }

  .seb-wrap :global(.se-gate) {
    flex: 0 0 auto;
    font-family: var(--dk-font-mono);
    font-size: 0.6rem;
    color: var(--dk-muted-alt, var(--dk-muted));
    padding: 0 0.25rem;
    letter-spacing: 0.04em;
    user-select: none;
    white-space: nowrap;
  }

  .seb-wrap :global(.se-framing) {
    font-family: var(--dk-font-body);
    font-style: italic;
    font-size: 0.9rem;
    color: var(--dk-muted);
    margin: var(--dk-space-sm, 0.75rem) 0 0;
  }

  .seb-wrap :global(.se-panel) {
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    padding: 0 var(--dk-space-lg, 2rem);
    margin-top: var(--dk-space-md, 1.25rem);
    border-radius: var(--dk-radius-md, 12px);
    border: 1px solid var(--dk-divider);
    background: var(--dk-bg-alt);
    background: rgba(207, 200, 230, 0.06); /* pastel-lavender 6% — explicit hex, no relative-color dependency */
    transition: max-height 250ms ease, opacity 250ms ease, padding 250ms ease;
  }

  .seb-wrap :global(.se-panel--open) {
    max-height: 900px;
    opacity: 1;
    padding: var(--dk-space-md, 1.25rem) var(--dk-space-lg, 2rem);
  }

  .seb-wrap :global(.se-panel-name) {
    font-family: var(--dk-font-display);
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    font-weight: 700;
    margin: 0;
  }

  .seb-wrap :global(.se-panel-role) {
    font-family: var(--dk-font-body);
    font-style: italic;
    color: var(--dk-muted);
    margin: 0.35rem 0 var(--dk-space-md, 1.25rem);
  }

  .seb-wrap :global(.se-steps-table) {
    display: flex;
    flex-direction: column;
    margin: var(--dk-space-sm, 0.75rem) 0 var(--dk-space-md, 1.25rem);
    border-radius: var(--dk-radius-sm, 8px);
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--sc) 20%, var(--dk-divider));
  }

  .seb-wrap :global(.se-step-row) {
    display: grid;
    grid-template-columns: minmax(120px, 160px) 1fr auto;
    gap: 8px 12px;
    align-items: start;
    padding: 10px 14px;
    border-bottom: 1px solid color-mix(in srgb, var(--dk-divider) 60%, transparent);
    transition: background 0.12s;
  }

  .seb-wrap :global(.se-step-row:last-child) {
    border-bottom: none;
  }

  .seb-wrap :global(.se-step-row:hover) {
    background: color-mix(in srgb, var(--sc) 5%, transparent);
  }

  .seb-wrap :global(.se-step-id) {
    font-family: var(--dk-font-mono);
    font-size: 0.72rem;
    color: var(--sc);
    background: color-mix(in srgb, var(--sc) 12%, transparent);
    border: 1px solid color-mix(in srgb, var(--sc) 25%, transparent);
    padding: 2px 6px;
    border-radius: 4px;
    white-space: nowrap;
    align-self: start;
  }

  .seb-wrap :global(.se-step-purpose) {
    font-family: var(--dk-font-body);
    font-size: clamp(0.78rem, 1.3vw, 0.92rem);
    color: var(--dk-text);
    line-height: 1.5;
    margin: 0;
  }

  .seb-wrap :global(.se-step-produces) {
    font-family: var(--dk-font-mono);
    font-size: 0.65rem;
    color: var(--dk-muted);
    white-space: nowrap;
    align-self: start;
    padding-top: 3px;
  }

  @media (max-width: 680px) {
    .seb-wrap :global(.se-nodes) {
      flex-wrap: wrap;
      gap: 4px;
    }
    .seb-wrap :global(.se-gate) {
      display: none;
    }
    .seb-wrap :global(.se-step-row) {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .seb-wrap :global(.se-step-produces) {
      white-space: normal;
    }
  }

  .seb-wrap :global(.se-panel-artifact) {
    font-size: 0.95rem;
    color: var(--dk-text);
    margin: 0;
  }

  .seb-wrap :global(.se-artifact-label) {
    font-family: var(--dk-font-mono);
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--dk-muted);
  }

  .seb-ns {
    margin: var(--dk-space-md, 1.25rem) 0;
    color: var(--dk-text);
  }
  .seb-ns dt {
    font-family: var(--dk-font-display);
    font-weight: 700;
    margin-top: 0.75rem;
  }
  .seb-ns dd {
    margin: 0.2rem 0 0;
    font-family: var(--dk-font-body);
    font-size: 0.9rem;
    color: var(--dk-muted);
  }
  .seb-ns-steps {
    margin: 0.2rem 0 0.4rem;
    padding-left: 1.1rem;
  }
  .seb-ns-steps li {
    margin: 0.15rem 0;
  }
  .seb-ns-steps code {
    font-family: var(--dk-font-mono);
    color: var(--dk-text);
  }
  .seb-ns-artifact {
    font-family: var(--dk-font-mono);
    font-size: 0.8rem;
    color: var(--dk-text);
  }

  @media print {
    .seb-wrap :global(.se-nodes) {
      display: none;
    }
    .seb-wrap :global(.se-framing) {
      display: none;
    }
    .seb-wrap :global(.se-panel) {
      display: block !important;
      max-height: none !important;
      opacity: 1 !important;
      padding: 1rem 1.5rem;
      margin-bottom: 1rem;
    }
    .seb-ns {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .seb-wrap :global(.se-panel) {
      transition-duration: 0ms !important;
    }
    .seb-wrap :global(.se-node) {
      transition: none !important;
    }
  }
</style>
