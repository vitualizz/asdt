  .deck-app :global(.law-card--l1 .law-number) { color: var(--dk-blue); }
  .deck-app :global(.law-card--l2 .law-number) { color: var(--dk-yellow); }
  .deck-app :global(.law-card--l3 .law-number) { color: var(--dk-green); }
  .deck-app :global(.law-title) {
