---
import SpecialistCard from '@components/SpecialistCard.astro'
import type { UIStrings } from '@i18n/types'
import type { Locale } from '@i18n/utils'
import { getBaseHref } from '@i18n/utils'

// Lean docs-scoped reuse of SpecialistCard for skills.md — no landing-page hero chrome
// (kicker/sub/deco/SpecialistAdvisor), just the 7 specialist cards, each linking to its
// specialists/{id} doc page. See SpecialistsGrid.astro for the full landing-page version.
interface Props {
  t: UIStrings
  locale: Locale
}
const { t, locale } = Astro.props
const isEs = locale === 'es'

function hrefFor(id: string): string {
  return isEs ? getBaseHref(`/es/docs/specialists/${id}`) : getBaseHref(`/docs/specialists/${id}`)
}
---
<ul class="skills-grid" role="list">
  {t.specialists.items.map((s) => (
    <li>
      <SpecialistCard specialist={s} href={hrefFor(s.id)} />
    </li>
  ))}
</ul>

<style>
.skills-grid {
  display: grid;
  gap: 16px;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  list-style: none;
  margin: 0;
  padding: 0;
}
</style>
