  .deck-app :global(.law-card--l1 .law-ex-label) { color: var(--dk-blue); }
  .deck-app :global(.law-card--l2 .law-ex-label) { color: var(--dk-yellow); }
  .deck-app :global(.law-card--l3 .law-ex-label) { color: var(--dk-green); }

  .deck-app :global(.install-block) {
    background: rgba(28, 33, 44, 0.85);
    border: 1px solid var(--dk-divider);
    border-radius: var(--dk-radius-md);
    padding: 1.25rem;
    margin: 0.75rem 0;
    font-family: var(--dk-font-mono);
    color: var(--dk-green);
    font-size: clamp(0.85rem, 1.5vw, 1.1rem);
    box-shadow: var(--dk-shadow-md);
  }

  /* Nav / footer hide while deck is active (normal browser view) */
  :global([data-deck-active] header.nav) {
    display: none !important;
  }
  :global([data-deck-active] footer.site-footer) {
    display: none !important;
  }

  /* ----- Responsive ----- */
  @media (max-width: 1040px) {
    .deck-app {
      padding: 12px;
      gap: 10px;
    }
    .stage-layout {
      grid-template-columns: 170px 1fr;
      gap: 10px;
    }
    .deck-app :global(section.slide) {
      padding: 14px;
      grid-template-columns: minmax(180px, 38%) 1fr;
      gap: 12px;
    }
    .deck-app :global(section.slide.is-entering),
    .deck-app :global(section.slide.is-leaving) {
