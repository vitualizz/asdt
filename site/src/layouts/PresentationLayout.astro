  .deck-app :global(.law-body) {
    font-family: var(--dk-font-body);
    font-size: 0.85rem;
    color: var(--dk-text);
    line-height: 1.55;
    margin: 0 0 0.5rem;
  }
  .deck-app :global(.law-example) {
    font-family: var(--dk-font-body);
    font-style: italic;
    font-size: 0.8rem;
    color: var(--dk-muted);
    margin: 0;
    padding: 0.4rem 0.7rem;
