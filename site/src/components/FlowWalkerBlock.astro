---
import { FlowWalker } from './FlowWalker'
import type { PipelineFlow } from '@data/pipeline-flow-steps'
import type { Locale } from '@i18n/utils'
import { useTranslations } from '@i18n/utils'

interface Props {
  flow: PipelineFlow
  lang: Locale
}
const { flow, lang } = Astro.props
const t = useTranslations(lang)
const flowT = t.data.pipelineFlows[flow.id]
const steps = flow.steps.map((s) => ({
  ...s,
  description: flowT.steps[s.id].description,
}))
---

<div class="fwb-wrap">
  <FlowWalker
    client:visible
    title={flowT.title}
    steps={steps}
    labelStep={t.docs.flowStep}
    labelOf={t.docs.flowOf}
  />

  <noscript>
    <ol class="fwb-static">
      {steps.map((s) => (
        <li class="fwb-static-step">
          <code class="fwb-static-cmd">{s.command}</code>
          <p>{s.description}</p>
        </li>
      ))}
    </ol>
  </noscript>

  <div class="fwb-print-all" aria-hidden="true">
    <ol class="fwb-static">
      {steps.map((s) => (
        <li class="fwb-static-step">
          <code class="fwb-static-cmd">{s.command}</code>
          <p>{s.description}</p>
        </li>
      ))}
    </ol>
  </div>
</div>

<style>
.fwb-wrap {
  height: 100%;
  min-height: 0;
  display: flex;
  flex-direction: column;
  /* alias site-level tokens (used by .fw rules) into the deck-scoped --dk-* set */
  --border-soft: var(--dk-divider);
  --font-mono: var(--dk-font-mono);
  --color-text: var(--dk-text);
  --sc: var(--tone);
  --faint: var(--dk-muted-alt);
}

.fwb-wrap :global(.fw) {
  margin: 0;
  border: none;
  border-radius: 8px;
  overflow: hidden;
  background: oklch(from var(--sc) l c h / 0.04);
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
}

.fwb-wrap :global(.fw-header) {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14px 18px;
  border-bottom: 1px solid var(--border-soft);
  background: oklch(from var(--sc) l c h / 0.06);
}

.fwb-wrap :global(.fw-counter) {
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--faint);
}

.fwb-wrap :global(.fw-command) {
  display: block;
  font-family: var(--font-mono);
  font-size: 13px;
  color: var(--sc);
  background: oklch(from var(--sc) l c h / 0.08);
  padding: 14px 18px;
  border-bottom: 1px solid oklch(from var(--border-soft) l c h / 0.5);
}

.fwb-wrap :global(.fw-desc) {
  font-size: 14.5px;
  color: oklch(0.92 0.008 285);
  line-height: 1.6;
  padding: 16px 18px;
  margin: 0;
  flex: 1;
  border-bottom: 1px solid oklch(from var(--border-soft) l c h / 0.5);
}

.fwb-wrap :global(.fw-dots) {
  display: flex;
  gap: 6px;
  padding: 8px 18px;
  align-items: center;
}

.fwb-wrap :global(.fw-dot) {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  border: none;
  background: oklch(from var(--sc) l c h / 0.20);
  padding: 0;
  transition: background 0.15s, transform 0.15s;
}

.fwb-wrap :global(.fw-dot--active) {
  background: var(--sc);
  transform: scale(1.25);
}

html[data-theme='light'] .fwb-wrap :global(.fw-desc) {
  color: oklch(0.28 0.012 285);
}

html[data-theme='light'] .fwb-wrap :global(.fw-command) {
  background: oklch(from var(--sc) l c h / 0.10);
}

@media (prefers-reduced-motion: reduce) {
  .fwb-wrap :global(.fw-dot) {
    transition: none;
  }
}

.fwb-print-all {
  display: none;
}

.fwb-static {
  list-style: decimal;
  padding-left: 1.4rem;
  margin: 0;
}

.fwb-static-step {
  margin-bottom: 0.75rem;
  font-family: var(--dk-font-body, serif);
  color: var(--dk-text, #F3F6F9);
}

.fwb-static-cmd {
  display: block;
  font-family: var(--dk-font-mono, monospace);
  font-size: 0.85rem;
  color: var(--sc, var(--dk-teal, #7AA89F));
  margin-bottom: 0.25rem;
}

@media print {
  .fwb-wrap :global(.fw) {
    display: none !important;
  }
  .fwb-print-all {
    display: block !important;
  }
}
</style>
