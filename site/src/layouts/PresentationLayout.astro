---
/**
 * PresentationLayout — native Astro/Tailwind shell for the ASDT talk decks.
 *
 * Ports the `deck-stage` web-component runtime to a dependency-free client:
 *   - fixed 1920x1080 canvas scaled to the viewport (letterboxed),
 *   - keyboard / tap / number-key navigation, reset (R), speaker notes (S),
 *   - idle-fading HUD with slide counter,
 *   - print: one slide per page at design size,
 *   - graceful no-JS fallback (slides render stacked).
 *
 * Slides are passed through the <slot/> verbatim — each keeps its own inline
 * styles. The shell forces slide geometry with `!important` and never touches
 * a slide's `style` attribute. The `[data-deck-active]` animation rules below
 * are reproduced from the source deck unchanged.
 */
type Locale = 'en' | 'es'

interface Props {
  title: string
  lang: Locale
  description?: string
}

const { title, lang, description = 'ASDT' } = Astro.props

const hud = {
  en: { nav: 'arrows to navigate', index: 'O index', notes: 'S notes', reset: 'R reset' },
  es: { nav: 'flechas para navegar', index: 'O índice', notes: 'S notas', reset: 'R reinicio' },
}[lang]
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Instrument+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <style is:global>
      /* ── deck chrome ─────────────────────────────────────────────── */
      html,
      body {
        margin: 0;
        padding: 0;
        height: 100%;
        background: #0b0c11;
        color: #dfe4ec;
      }
      .deck-viewport {
        position: relative;
        min-height: 100vh;
      }
      .deck-canvas {
        margin: 0 auto;
        transform-origin: top center;
      }
      .deck-slides > section {
        width: 1920px;
        height: 1080px;
      }

      /* JS active: fixed letterboxed canvas, one slide at a time */
      .deck-ready .deck-viewport {
        position: fixed;
        inset: 0;
        overflow: hidden;
        display: grid;
        place-items: center;
        background: #0b0c11;
      }
      .deck-ready .deck-canvas {
        position: relative;
        width: 1920px;
        height: 1080px;
        margin: 0;
        transform-origin: center center;
      }
      .deck-ready .deck-slides {
        position: absolute;
        inset: 0;
      }
      .deck-ready .deck-slides > section {
        position: absolute !important;
        inset: 0;
        width: 100%;
        height: 100%;
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transition: opacity 0.32s ease;
      }
      .deck-ready .deck-slides > section.is-active {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
      }

      /* HUD */
      .deck-hud {
        position: fixed;
        left: 50%;
        bottom: 26px;
        transform: translateX(-50%);
        display: none;
        align-items: center;
        gap: 18px;
        padding: 10px 18px;
        border-radius: 999px;
        background: rgba(11, 12, 17, 0.72);
        border: 1px solid rgba(255, 255, 255, 0.12);
        backdrop-filter: blur(8px);
        font-family: 'JetBrains Mono', monospace;
        font-size: 15px;
        letter-spacing: 0.04em;
        color: #9aa3b2;
        z-index: 40;
        transition: opacity 0.4s ease;
      }
      .deck-ready .deck-hud {
        display: flex;
      }
      .deck-hud.is-idle {
        opacity: 0;
      }
      .deck-hud button {
        appearance: none;
        background: none;
        border: 0;
        color: #cdd4df;
        font: inherit;
        cursor: pointer;
        padding: 2px 8px;
        border-radius: 8px;
        line-height: 1;
      }
      .deck-hud button:hover {
        background: rgba(255, 255, 255, 0.08);
        color: #fff;
      }
      .deck-hud .deck-counter {
        color: #f3f6fb;
        font-weight: 600;
        min-width: 64px;
        text-align: center;
      }
      .deck-hud .deck-hint {
        color: #6b7484;
        font-size: 13px;
        border-left: 1px solid rgba(255, 255, 255, 0.12);
        padding-left: 14px;
      }

      /* Speaker notes overlay */
      .deck-notes {
        position: fixed;
        left: 50%;
        bottom: 84px;
        transform: translateX(-50%);
        max-width: 980px;
        width: calc(100vw - 80px);
        padding: 22px 26px;
        border-radius: 14px;
        background: rgba(6, 7, 11, 0.94);
        border: 1px solid rgba(255, 255, 255, 0.14);
        box-shadow: 0 18px 60px rgba(0, 0, 0, 0.55);
        font-family: 'Instrument Sans', system-ui, sans-serif;
        font-size: 21px;
        line-height: 1.5;
        color: #cdd4df;
        z-index: 41;
        display: none;
      }
      .deck-notes.is-open {
        display: block;
      }
      .deck-notes .deck-notes-label {
        display: block;
        font-family: 'JetBrains Mono', monospace;
        font-size: 12px;
        letter-spacing: 0.16em;
        text-transform: uppercase;
        color: #6b7484;
        margin-bottom: 10px;
      }

      /* Slide index (overview grid) */
      .deck-overview {
        position: fixed;
        inset: 0;
        z-index: 60;
        display: none;
        padding: 46px 48px;
        overflow: auto;
        background: rgba(8, 9, 13, 0.94);
        backdrop-filter: blur(6px);
      }
      .deck-overview.is-open {
        display: block;
      }
      .deck-overview-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 22px;
        max-width: 1560px;
        margin: 0 auto;
      }
      @media (max-width: 1100px) {
        .deck-overview-grid {
          grid-template-columns: repeat(3, 1fr);
        }
      }
      @media (max-width: 760px) {
        .deck-overview-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      .deck-thumb {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        padding: 0;
        border: 2px solid rgba(255, 255, 255, 0.12);
        border-radius: 12px;
        background: #0b0c11;
        cursor: pointer;
        transition:
          border-color 0.18s ease,
          transform 0.18s ease;
      }
      .deck-thumb:hover {
        transform: translateY(-3px);
        border-color: rgba(255, 255, 255, 0.32);
      }
      .deck-thumb.is-current {
        border-color: oklch(76% 0.15 155);
        box-shadow: 0 0 26px oklch(76% 0.15 155 / 0.32);
      }
      .deck-thumb:focus-visible {
        outline: 2px solid oklch(74% 0.145 245);
        outline-offset: 3px;
      }
      .deck-thumb-frame {
        position: absolute;
        top: 0;
        left: 0;
        transform-origin: top left;
        pointer-events: none;
      }
      .deck-thumb-frame > section {
        width: 1920px !important;
        height: 1080px !important;
        position: relative !important;
        inset: auto !important;
        margin: 0 !important;
        opacity: 1 !important;
        visibility: visible !important;
      }
      .deck-thumb-cap {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 18px 14px 9px;
        background: linear-gradient(to top, rgba(6, 7, 11, 0.94), transparent);
        font-family: 'JetBrains Mono', monospace;
        font-size: 14px;
        color: #e7ebf2;
        text-align: left;
      }
      .deck-thumb-num {
        color: #6b7484;
        font-weight: 600;
      }

      /* ── animation system (verbatim from source deck) ───────────── */
      summary {
        list-style: none;
        cursor: pointer;
      }
      summary::-webkit-details-marker {
        display: none;
      }
      summary::marker {
        content: '';
      }
      details[open] .chev {
        transform: rotate(45deg);
      }

      @keyframes asdtRise {
        from {
          opacity: 0;
          transform: translateY(20px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
      @keyframes asdtRight {
        from {
          opacity: 0;
          transform: translateX(46px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
      @keyframes asdtLeft {
        from {
          opacity: 0;
          transform: translateX(-46px);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
      @keyframes asdtFade {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
      @keyframes asdtScale {
        from {
          opacity: 0;
          transform: scale(0.9);
        }
        to {
          opacity: 1;
          transform: none;
        }
      }
      @keyframes asdtGrow {
        from {
          opacity: 0;
          transform: scaleY(0.04);
        }
        to {
          opacity: 1;
          transform: scaleY(1);
        }
      }
      @keyframes asdtDrawY {
        from {
          opacity: 0.2;
          transform: scaleY(0);
        }
        to {
          opacity: 1;
          transform: scaleY(1);
        }
      }
      @keyframes asdtGlow {
        0%,
        100% {
          box-shadow: 0 0 26px var(--g, rgba(80, 200, 120, 0.22));
        }
        50% {
          box-shadow: 0 0 64px var(--g, rgba(80, 200, 120, 0.6));
        }
      }
      @keyframes asdtFloat {
        0%,
        100% {
          transform: translateY(0);
        }
        50% {
          transform: translateY(-9px);
        }
      }
      @keyframes asdtBlink {
        0%,
        49% {
          opacity: 1;
        }
        50%,
        100% {
          opacity: 0;
        }
      }
      @keyframes asdtFlow {
        0% {
          transform: translateY(-6px);
          opacity: 0;
        }
        12% {
          opacity: 1;
        }
        88% {
          opacity: 1;
        }
        100% {
          transform: translateY(var(--flow, 120px));
          opacity: 0;
        }
      }
      @keyframes asdtType {
        from {
          width: 0;
        }
        to {
          width: 100%;
        }
      }

      @media (prefers-reduced-motion: no-preference) {
        [data-deck-active] .rise {
          animation: asdtRise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
        }
        [data-deck-active] .rise2 {
          animation: asdtRise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) 0.12s both;
        }
        [data-deck-active] .rise3 {
          animation: asdtRise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) 0.24s both;
        }
        [data-deck-active] .rise4 {
          animation: asdtRise 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) 0.36s both;
        }

        [data-deck-active] .au {
          animation: asdtRise 0.64s cubic-bezier(0.2, 0.7, 0.2, 1) both;
        }
        [data-deck-active] .ar {
          animation: asdtRight 0.64s cubic-bezier(0.2, 0.7, 0.2, 1) both;
        }
        [data-deck-active] .al {
          animation: asdtLeft 0.64s cubic-bezier(0.2, 0.7, 0.2, 1) both;
        }
        [data-deck-active] .af {
          animation: asdtFade 0.75s ease both;
        }
        [data-deck-active] .as {
          animation: asdtScale 0.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
        }
        [data-deck-active] .ag {
          transform-origin: bottom center;
          animation: asdtGrow 0.72s cubic-bezier(0.2, 0.7, 0.2, 1) both;
        }
        [data-deck-active] .adraw {
          transform-origin: top center;
          animation: asdtDrawY 0.5s ease both;
        }

        [data-deck-active] .d1 {
          animation-delay: 0.06s;
        }
        [data-deck-active] .d2 {
          animation-delay: 0.14s;
        }
        [data-deck-active] .d3 {
          animation-delay: 0.22s;
        }
        [data-deck-active] .d4 {
          animation-delay: 0.3s;
        }
        [data-deck-active] .d5 {
          animation-delay: 0.38s;
        }
        [data-deck-active] .d6 {
          animation-delay: 0.46s;
        }
        [data-deck-active] .d7 {
          animation-delay: 0.54s;
        }
        [data-deck-active] .d8 {
          animation-delay: 0.62s;
        }
        [data-deck-active] .d9 {
          animation-delay: 0.7s;
        }
        [data-deck-active] .d10 {
          animation-delay: 0.78s;
        }
        [data-deck-active] .d11 {
          animation-delay: 0.86s;
        }
        [data-deck-active] .d12 {
          animation-delay: 0.94s;
        }

        [data-deck-active] .glow {
          animation: asdtGlow 2.8s ease-in-out 1s infinite;
        }
        [data-deck-active] .float {
          animation: asdtFloat 3.6s ease-in-out 1s infinite;
        }
        [data-deck-active] .blink {
          animation: asdtBlink 1.1s step-end infinite;
        }
        [data-deck-active] .flowdot {
          animation: asdtFlow 2.2s ease-in-out 1.1s infinite;
        }
        [data-deck-active] .typ {
          overflow: hidden;
          white-space: nowrap;
          animation: asdtType 0.9s steps(34) both;
        }
      }
      .flowdot {
        display: none;
      }
      @media (prefers-reduced-motion: no-preference) {
        [data-deck-active] .flowdot {
          display: block;
        }
      }

      /* ── print: one slide per page at design size ───────────────── */
      @media print {
        .deck-hud,
        .deck-notes {
          display: none !important;
        }
        .deck-ready .deck-viewport {
          position: static;
          display: block;
        }
        .deck-ready .deck-canvas {
          width: 1920px;
          height: auto;
          transform: none !important;
        }
        .deck-ready .deck-slides {
          position: static;
        }
        .deck-ready .deck-slides > section {
          position: relative !important;
          inset: auto;
          opacity: 1 !important;
          visibility: visible !important;
          page-break-after: always;
          break-after: page;
        }
      }
    </style>
  </head>
  <body>
    <div class="deck-viewport">
      <div class="deck-canvas">
        <div class="deck-slides">
          <slot />
        </div>
      </div>
    </div>

    <div class="deck-notes" aria-live="polite">
      <span class="deck-notes-label">Speaker notes</span>
      <span class="deck-notes-body"></span>
    </div>

    <div class="deck-hud" role="navigation">
      <button type="button" data-deck-prev aria-label="Previous slide">‹</button>
      <span class="deck-counter">1 / 1</span>
      <button type="button" data-deck-next aria-label="Next slide">›</button>
      <button type="button" data-deck-overview aria-label="Slide index">⊞</button>
      <span class="deck-hint">{hud.nav} · {hud.index} · {hud.notes} · {hud.reset}</span>
    </div>

    <div class="deck-overview" role="dialog" aria-modal="true" aria-label="Slide index">
      <div class="deck-overview-grid"></div>
    </div>

    <script>
      // Native deck controller — replaces the deck-stage web component.
      const DESIGN_W = 1920
      const DESIGN_H = 1080

      const body = document.body
      const viewport = document.querySelector<HTMLElement>('.deck-viewport')!
      const canvas = document.querySelector<HTMLElement>('.deck-canvas')!
      const slides = Array.from(
        document.querySelectorAll<HTMLElement>('.deck-slides > section'),
      )
      const counter = document.querySelector<HTMLElement>('.deck-counter')!
      const hud = document.querySelector<HTMLElement>('.deck-hud')!
      const notes = document.querySelector<HTMLElement>('.deck-notes')!
      const notesBody = document.querySelector<HTMLElement>('.deck-notes-body')!
      const overview = document.querySelector<HTMLElement>('.deck-overview')!
      const grid = document.querySelector<HTMLElement>('.deck-overview-grid')!
      const overviewBtn = document.querySelector<HTMLElement>('[data-deck-overview]')

      const total = slides.length
      let current = 0

      body.classList.add('deck-ready')

      function fit() {
        const scale = Math.min(
          window.innerWidth / DESIGN_W,
          window.innerHeight / DESIGN_H,
        )
        canvas.style.transform = `scale(${scale})`
      }

      function show(index: number) {
        current = Math.max(0, Math.min(total - 1, index))
        slides.forEach((s, i) => {
          const active = i === current
          s.classList.toggle('is-active', active)
          // re-trigger entrance animations on the active slide
          s.removeAttribute('data-deck-active')
          if (active) {
            void s.offsetWidth
            s.setAttribute('data-deck-active', '')
          }
        })
        const label = slides[current].getAttribute('data-label') || ''
        counter.textContent =
          `${current + 1} / ${total}` + (label ? ` · ${label}` : '')
        grid
          .querySelectorAll('.deck-thumb')
          .forEach((c, i) => c.classList.toggle('is-current', i === current))
        notesBody.textContent =
          slides[current].getAttribute('data-speaker-notes') || ''
        if (history.replaceState) {
          history.replaceState(null, '', `#${current + 1}`)
        }
      }

      function next() {
        if (current < total - 1) show(current + 1)
      }
      function prev() {
        if (current > 0) show(current - 1)
      }

      // ── slide index (overview grid) ────────────────────────────
      let overviewBuilt = false
      let overviewOpen = false

      function buildOverview() {
        slides.forEach((s, i) => {
          const cell = document.createElement('button')
          cell.type = 'button'
          cell.className = 'deck-thumb'
          const label = s.getAttribute('data-label') || ''
          cell.setAttribute('aria-label', `${i + 1}. ${label}`)

          const frame = document.createElement('div')
          frame.className = 'deck-thumb-frame'
          const clone = s.cloneNode(true) as HTMLElement
          clone.removeAttribute('data-deck-active')
          clone.classList.remove('is-active')
          frame.appendChild(clone)

          const cap = document.createElement('div')
          cap.className = 'deck-thumb-cap'
          const num = document.createElement('span')
          num.className = 'deck-thumb-num'
          num.textContent = String(i + 1).padStart(2, '0')
          const name = document.createElement('span')
          name.textContent = label
          cap.append(num, name)

          cell.append(frame, cap)
          cell.addEventListener('click', () => {
            show(i)
            closeOverview()
          })
          grid.appendChild(cell)
        })
        overviewBuilt = true
      }

      function scaleThumbs() {
        grid.querySelectorAll<HTMLElement>('.deck-thumb').forEach((cell) => {
          const frame = cell.querySelector<HTMLElement>('.deck-thumb-frame')!
          frame.style.transform = `scale(${cell.clientWidth / DESIGN_W})`
        })
      }

      function gridCols() {
        return getComputedStyle(grid).gridTemplateColumns.split(' ').length
      }

      function openOverview() {
        if (!overviewBuilt) buildOverview()
        overview.classList.add('is-open')
        overviewOpen = true
        scaleThumbs()
        const cells = grid.querySelectorAll<HTMLElement>('.deck-thumb')
        cells.forEach((c, i) => c.classList.toggle('is-current', i === current))
        cells[current]?.focus()
      }
      function closeOverview() {
        overview.classList.remove('is-open')
        overviewOpen = false
        overviewBtn?.focus()
      }
      function toggleOverview() {
        if (overviewOpen) closeOverview()
        else openOverview()
      }

      function overviewKeys(e: KeyboardEvent) {
        const cells = Array.from(
          grid.querySelectorAll<HTMLElement>('.deck-thumb'),
        )
        let idx = cells.indexOf(document.activeElement as HTMLElement)
        if (idx < 0) idx = current
        const cols = gridCols()
        const last = cells.length - 1
        switch (e.key) {
          case 'ArrowRight':
            e.preventDefault()
            cells[Math.min(last, idx + 1)].focus()
            break
          case 'ArrowLeft':
            e.preventDefault()
            cells[Math.max(0, idx - 1)].focus()
            break
          case 'ArrowDown':
            e.preventDefault()
            cells[Math.min(last, idx + cols)].focus()
            break
          case 'ArrowUp':
            e.preventDefault()
            cells[Math.max(0, idx - cols)].focus()
            break
          case 'Home':
            e.preventDefault()
            cells[0].focus()
            break
          case 'End':
            e.preventDefault()
            cells[last].focus()
            break
          case 'Enter':
          case ' ':
            e.preventDefault()
            show(idx)
            closeOverview()
            break
        }
      }

      overview.addEventListener('click', (e) => {
        if (e.target === overview) closeOverview()
      })
      overviewBtn?.addEventListener('click', toggleOverview)
      document
        .querySelector('[data-deck-prev]')
        ?.addEventListener('click', prev)
      document
        .querySelector('[data-deck-next]')
        ?.addEventListener('click', next)

      // ── HUD idle fade ──────────────────────────────────────────
      let idleTimer: number | undefined
      function wake() {
        hud.classList.remove('is-idle')
        window.clearTimeout(idleTimer)
        idleTimer = window.setTimeout(() => hud.classList.add('is-idle'), 2600)
      }

      // ── keyboard ───────────────────────────────────────────────
      let numberBuffer = ''
      let numberTimer: number | undefined
      window.addEventListener('keydown', (e) => {
        wake()
        if (e.key === 'o' || e.key === 'O' || e.key === 'Escape') {
          e.preventDefault()
          toggleOverview()
          return
        }
        if (overviewOpen) {
          overviewKeys(e)
          return
        }
        switch (e.key) {
          case 'ArrowRight':
          case 'PageDown':
          case ' ':
            e.preventDefault()
            next()
            return
          case 'ArrowLeft':
          case 'PageUp':
            e.preventDefault()
            prev()
            return
          case 'Home':
            e.preventDefault()
            show(0)
            return
          case 'End':
            e.preventDefault()
            show(total - 1)
            return
          case 'r':
          case 'R':
            show(0)
            return
          case 's':
          case 'S':
            notes.classList.toggle('is-open')
            return
        }
        if (e.key >= '0' && e.key <= '9') {
          numberBuffer += e.key
          window.clearTimeout(numberTimer)
          numberTimer = window.setTimeout(() => {
            const n = parseInt(numberBuffer, 10)
            if (n >= 1 && n <= total) show(n - 1)
            numberBuffer = ''
          }, 550)
        }
      })

      // ── tap / click navigation (ignore interactive targets) ────
      viewport.addEventListener('click', (e) => {
        wake()
        const el = e.target as HTMLElement
        if (el.closest('a, button, summary, details, input, [data-deck-interactive]'))
          return
        if (e.clientX < window.innerWidth / 2) prev()
        else next()
      })

      window.addEventListener('mousemove', wake)
      window.addEventListener('resize', () => {
        fit()
        if (overviewOpen) scaleThumbs()
      })

      // ── boot ───────────────────────────────────────────────────
      const fromHash = parseInt(location.hash.replace('#', ''), 10)
      fit()
      show(Number.isFinite(fromHash) && fromHash >= 1 ? fromHash - 1 : 0)
      wake()
    </script>
  </body>
</html>
