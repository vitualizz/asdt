---
import PresentationLayout from '@layouts/PresentationLayout.astro'
import { getCollection, render } from 'astro:content'

export async function getStaticPaths() {
  const esTalks = await getCollection('talks', (e) => e.data.locale === 'es')
  const enTalks = await getCollection('talks', (e) => e.data.locale === 'en')

  const esSlugs = new Set(esTalks.map((e) => e.id.replace(/^es\//, '')))

  const esRoutes = esTalks.map((entry) => ({
    params: { slug: entry.id.replace(/^es\//, '') },
    props: { entry, isFallback: false },
  }))

  const enFallbacks = enTalks
    .filter((entry) => !esSlugs.has(entry.id.replace(/^en\//, '')))
    .map((entry) => ({
      params: { slug: entry.id.replace(/^en\//, '') },
      props: { entry, isFallback: true },
    }))

  return [...esRoutes, ...enFallbacks]
}

const { entry, isFallback } = Astro.props
const { Content } = await render(entry)
---
<PresentationLayout
  lang="es"
  title={entry.data.title}
  description={entry.data.description}
  isFallback={isFallback}
>
  <Content />
</PresentationLayout>
