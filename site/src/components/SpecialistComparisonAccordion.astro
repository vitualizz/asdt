---
import { specialistComparison } from '@data/specialist-comparison'
import type { SpecialistComparisonRow } from '@data/specialist-comparison'
import { SPECIALIST_COLOR, SPECIALIST_LABEL } from '@data/artifact-graph'
import type { SpecialistId } from '@data/artifact-graph'
import { useTranslations, getLocalePath } from '@i18n/utils'
import type { Locale } from '@i18n/utils'

interface Props {
  lang: Locale
  rows?: SpecialistComparisonRow[]
}

const { lang, rows = specialistComparison } = Astro.props
const t = useTranslations(lang)

// Reuses SpecialistCard.astro's icon vocabulary verbatim for the 6 shared ids;
// researcher (not covered there) gets an added search-glyph icon.
const iconPaths: Record<SpecialistId, string> = {
  pm: 'M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01',
  architect: 'M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z',
  developer: 'M16 18 22 12 16 6M8 6 2 12 8 18',
  qa: 'M9 12l2 2 4-4m6 2a9 9 0 1 1-18 0 9 9 0 0 1 18 0z',
  security: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
  'ux-ui': 'M2 13.5V19a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-5.5M22 10.5 12 5 2 10.5M12 5v14',
  researcher: 'M11 4a7 7 0 1 0 0 14 7 7 0 0 0 0-14zM21 21l-4.35-4.35',
}

const labelInvoke = t.specialistComparison.invokeWhen
const labelProduces = t.docs.produces
const labelDoNotUse = t.specialistComparison.doNotUseWhen
const labelExample = t.specialistComparison.exampleCommand

function commandLiteral(exampleCommand: string): string {
  return exampleCommand.split(' ')[0]
}
---

<div class="my-6 flex flex-col gap-2.5">
  {rows.map((row) => {
    const colorVar = SPECIALIST_COLOR[row.specialistId]
    const name = SPECIALIST_LABEL[row.specialistId]
    const iconPath = iconPaths[row.specialistId]
    const copy = t.data.specialistComparison[row.specialistId]
    return (
      <details
        class="group overflow-hidden rounded-xl border border-border-soft bg-surface-2 open:border-[oklch(from_var(--sc)_l_c_h/0.30)] open:bg-[oklch(from_var(--sc)_l_c_h/0.06)]"
        style={`--sc: var(${colorVar});`}
      >
        <summary class="cmp-summary flex min-h-11 cursor-pointer list-none flex-wrap items-center gap-3 py-3.5 px-[18px] hover:bg-[oklch(from_var(--sc)_l_c_h/0.04)] max-[640px]:py-3 max-[640px]:px-3.5">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-[9px] border border-[oklch(from_var(--sc)_l_c_h/0.30)] bg-[oklch(from_var(--sc)_l_c_h/0.12)] text-[var(--sc)]" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
              <path d={iconPath} />
            </svg>
          </span>
          <span class="shrink-0 text-[15.5px] font-semibold text-[var(--sc)]">{name}</span>
          <code class="shrink-0 whitespace-nowrap rounded-full border border-[oklch(from_var(--sc)_l_c_h/0.35)] bg-[oklch(from_var(--sc)_l_c_h/0.08)] px-2.5 py-0.5 font-mono text-[11.5px] text-[var(--sc)]">{commandLiteral(row.exampleCommand)}</code>
          <span class="min-w-0 flex-[1_1_220px] text-sm leading-normal text-text-muted max-[640px]:order-5 max-[640px]:basis-full">{copy.teaser}</span>
          <svg class="shrink-0 ml-auto text-faint motion-safe:transition-transform motion-safe:duration-200 motion-safe:ease-in-out group-open:rotate-180" aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M6 9l6 6 6-6" />
          </svg>
        </summary>
        <div class="pt-1 pr-[18px] pb-5 pl-16 max-[640px]:px-3.5 max-[640px]:pt-1 max-[640px]:pb-[18px]">
          <dl class="m-0 flex flex-col gap-1">
            <dt class="mt-3.5 font-mono text-[10px] tracking-[0.1em] uppercase text-faint first:mt-0">{labelInvoke}</dt>
            <dd class="cmp-dd mx-0 mt-1 mb-0 text-[14.5px] leading-[1.6] text-[oklch(0.86_0.008_285)]">{copy.invokeWhen}</dd>
            <dt class="mt-3.5 font-mono text-[10px] tracking-[0.1em] uppercase text-faint first:mt-0">{labelProduces}</dt>
            <dd class="cmp-dd mx-0 mt-1 mb-0 text-[14.5px] leading-[1.6] text-[oklch(0.86_0.008_285)]">{copy.produces}</dd>
            <dt class="mt-3.5 font-mono text-[10px] tracking-[0.1em] uppercase text-faint first:mt-0">{labelDoNotUse}</dt>
            <dd class="cmp-dd mx-0 mt-1 mb-0 text-[14.5px] leading-[1.6] text-[oklch(0.86_0.008_285)]">{copy.doNotUseWhen}</dd>
            <dt class="mt-3.5 font-mono text-[10px] tracking-[0.1em] uppercase text-faint first:mt-0">{labelExample}</dt>
            <dd class="cmp-dd mx-0 mt-1 mb-0 text-[14.5px] leading-[1.6] text-[oklch(0.86_0.008_285)]">
              <pre class="m-0 overflow-x-auto rounded-md border border-border bg-bg-deep px-3.5 py-3"><code class="border-0 bg-none p-0 font-mono text-[13px] leading-[1.7] whitespace-pre text-inherit">{row.exampleCommand}</code></pre>
            </dd>
          </dl>
          <a
            href={getLocalePath(`/docs/specialists/${row.specialistId}`, lang)}
            class="mt-4 inline-flex items-center gap-1 text-[13.5px] font-medium text-[var(--sc)] hover:underline"
          >
            {t.specialistComparison.fullDetailsLink}
          </a>
        </div>
      </details>
    )
  })}
</div>

<style>
/* <details><summary> ships a default disclosure marker in both the
   ::marker (Firefox) and ::-webkit-details-marker (Chrome/Safari) forms;
   neither has a Tailwind utility, so removal stays scoped. */
.cmp-summary::-webkit-details-marker {
  display: none;
}

.cmp-summary::marker {
  content: '';
}

html[data-theme='light'] .cmp-dd {
  color: var(--color-text);
}
</style>
