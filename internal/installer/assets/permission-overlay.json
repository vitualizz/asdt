{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "deny": [
      "Edit(**/.claude/settings.json)",
      "Write(**/.claude/settings.json)",
      "NotebookEdit(**/.claude/settings.json)",
      "Edit(**/.claude/**)",
      "Write(**/.claude/**)",
      "NotebookEdit(**/.claude/**)",
      "Edit(**/.env)",
      "Write(**/.env)",
      "NotebookEdit(**/.env)",
      "Edit(**/.env.*)",
      "Write(**/.env.*)",
      "NotebookEdit(**/.env.*)",
      "Edit(**/secrets/**)",
      "Write(**/secrets/**)",
      "NotebookEdit(**/secrets/**)",
      "Edit(**/*.pem)",
      "Write(**/*.pem)",
      "NotebookEdit(**/*.pem)",
      "Edit(**/*.key)",
      "Write(**/*.key)",
      "NotebookEdit(**/*.key)",
      "Edit(**/.zshrc)",
      "Write(**/.zshrc)",
      "NotebookEdit(**/.zshrc)",
      "Edit(**/.bashrc)",
      "Write(**/.bashrc)",
      "NotebookEdit(**/.bashrc)",
      "Edit(**/.bash_profile)",
      "Write(**/.bash_profile)",
      "NotebookEdit(**/.bash_profile)",
      "Edit(**/.profile)",
      "Write(**/.profile)",
      "NotebookEdit(**/.profile)",
      "Edit(**/.envrc)",
      "Write(**/.envrc)",
      "NotebookEdit(**/.envrc)",
      "Edit(**/.npmrc)",
      "Write(**/.npmrc)",
      "NotebookEdit(**/.npmrc)",
      "Edit(**/.gitconfig)",
      "Write(**/.gitconfig)",
      "NotebookEdit(**/.gitconfig)",
      "Edit(**/.mcp.json)",
      "Write(**/.mcp.json)",
      "NotebookEdit(**/.mcp.json)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(cat **/.env*)",
      "Bash(printenv*)",
      "Bash(base64 **/.env*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)"
    ]
  },
  "skipDangerousModePermissionPrompt": true
}
