  }
  .deck-app :global(.law-card--l1 .law-example) { border-left: 2px solid var(--dk-blue); }
  .deck-app :global(.law-card--l2 .law-example) { border-left: 2px solid var(--dk-yellow); }
  .deck-app :global(.law-card--l3 .law-example) { border-left: 2px solid var(--dk-green); }
  .deck-app :global(.law-ex-label) {
